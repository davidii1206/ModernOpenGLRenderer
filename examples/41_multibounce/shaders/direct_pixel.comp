#version 460 core
layout(local_size_x = 64) in;

// ---------------------------------------------------------------------------
// The direct term, one light view per PIXEL per emitter.
//
// Two things were wrong with taking the image's direct term off the GI grid, and
// they are independent:
//
//   RECEIVER DENSITY. The grid answers for an MBG_SCALE x MBG_SCALE block of
//   pixels, 4x4 by default, and a shadow boundary reconstructed from receivers
//   that far apart and then bilaterally upsampled is soft however good the
//   upsample is. Nyquist, not a filtering failure. Fixed by giving the direct
//   term its own receiver: one per pixel.
//
//   ANGULAR RESOLUTION ON THE LIGHT. Visibility off a hemisphere buffer is a
//   ratio of texel masses, so its precision is however many texels the emitter
//   covers -- 4 to 29 for Cornell's panel at a 32x32 target. Five or so
//   distinguishable values across a penumbra is a hard line with steps in it,
//   which is what the room's top edges and the box shadows showed. Fixed by
//   pointing the resolution at the light: see common/lightview.glsl.
//
// So this pass does not rasterize a hemisphere at all. Per emitter it fits a
// frustum to that emitter, rasterizes the emitter alone and then the whole scene
// into it, and takes the visible fraction from the two. Same rasterizer, same
// atomicMin depth sort, same read-the-winner rule -- the texels just point at the
// light instead of at the sky.
//
// The solve is untouched: every secondary camera still computes its own direct
// term off its hemisphere, because the bounce transport reads it and a soft
// answer is fine there. This changes only what the IMAGE reads, and the GI grid
// then carries the indirect residual alone (gather.comp's u_split). The
// subtraction stays self-consistent because it subtracts the camera's own direct
// term, whatever estimator produced it.
//
// ADDS INTO the upsampled target: it holds irradiance E directly, so this is a
// read-modify-write and needs no second full-resolution texture.
//
// AND IT DOES NOT INCLUDE raster.glsl, WHICH IS A PERFORMANCE DECISION.
//
// This pass never rasterizes a hemisphere -- that is the whole point of the
// light view -- so it needs nothing raster.glsl defines. Including it anyway
// still costs, because a GLSL header's `shared` declarations are paid by the
// includer whether or not it touches them: s_vis (4 KB), s_cdf (4 KB), s_red,
// s_red2 and s_blk (2.3 KB) would be 10.5 KB of shared memory this shader never
// reads.
//
// On a 64-thread workgroup that is the difference between roughly 12% and 29%
// occupancy on Ampere, and this is the most expensive pass in the renderer, so
// it is the difference the whole frame notices. Measured on an RTX 3060: 2317 ms
// down to the number in implementation.md's finding 22.
//
// The rule this is an instance of: shared memory belongs to the kernel, not to
// the header. Anything added below must keep this include list honest.
// ---------------------------------------------------------------------------

#include "scene.glsl"
#include "emitter.glsl"
#include "lightview.glsl"
#include "gbuffer.glsl"
#include "sky.glsl"

layout(std430, binding = 8) readonly buffer MbgEmit { uint emitters[]; };

layout(binding = 0) uniform sampler2D u_albedo;
layout(binding = 1) uniform sampler2D u_normal;
layout(binding = 3) uniform sampler2D u_depth;

layout(binding = 1, rgba32f) uniform image2D u_target;   // full resolution, (E, 1)
layout(binding = 2, rgba32f) uniform readonly image2D u_vis;  // GI grid, the two fractions

uniform ivec2 u_size;
uniform mat4  u_inv_view_proj;
uniform uint  u_tri_count;
uniform uint  u_emitters;
uniform uint  u_lv_res;        // light-view target edge
uniform uint  u_two_sided;
uniform float u_bias;
uniform float u_emissive;
uniform uint  u_cluster_count;
uniform ivec2 u_gi_size;
uniform uint  u_scale;
uniform uint  u_mask;
uniform float u_mask_eps_e;
uniform float u_mask_eps_s;
uniform float u_plane_tol;

shared vec4 s_lvred[64];
shared vec4 s_tap[4];        // per tap: (frac_e, frac_s, valid, bilinear weight)
shared vec4 s_mval;          // (frac_e, frac_s, refine_e, refine_s)

// --- Where a per-pixel light view is actually needed -------------------------
//
// THE GRID ALREADY KNOWS. Every secondary camera rasterizes its own hemisphere
// and reports what fraction of each light it could see, and finding 18 already
// keeps the emitter's fraction and the sun's apart. Across a 4x4 block that is
// four samples of the same function this pass is about to spend 64 texels of
// cone per pixel computing -- and where those four agree, there is no penumbra
// crossing the block and nothing for the extra resolution to resolve. Most of
// an interior is like that: fully lit, or fully shadowed, with a thin band
// between. Only the band needs the light view.
//
// NOTHING IS INTERPOLATED. A block is skipped only when its four samples agree
// that it is entirely lit or entirely in shadow, and then the fraction used is
// exactly 1 or exactly 0 -- a value the light view would have returned too, not
// a guess standing in for it. A block that agrees on some MIDDLE value is a
// block inside a penumbra, and those are computed.
//
// That is the whole difference between this and an upsample. The cheap answer
// is only taken where it is not an approximation at all; everything uncertain
// pays full price. The magnitude is closed form either way --
// mbg_emitter_unshadowed and mbg_sun_unshadowed read the receiver's own
// position and normal -- so a skipped pixel keeps its exact per-pixel cosine
// falloff and solid angle regardless.
//
// THE DECISION USES THE 2x2 THE VALUE COMES FROM, AND NO WIDER. A one-cell
// dilation ring around it was tried first, as insurance against a seam where a
// refined block meets an interpolated one, and it is a trap: four cells span 16
// pixels at scale 4, and in an arcade that window almost always straddles a
// shadow edge, so the range test failed everywhere and the mask skipped nothing
// at all on Sponza. The seam it guarded against is bounded by eps anyway -- a
// block is only skipped where the fraction varies by less than that, so the two
// estimators cannot part by more than that across the boundary.
//
// THE THRESHOLD IS NEARLY INERT, which is what made the rule above cheap to
// adopt. The grid's fraction comes off a cam_lv_res^2 light view, so it is
// quantised to multiples of 1/64 and an epsilon below that quantum is
// meaningless by construction. But 0.1 texel and 1 texel measured the same time
// to 1% and the same wrong pixels on Sponza: the blocks that skip are already
// the ones whose samples agree exactly, so refusing the partial ones costs
// almost nothing. The epsilon survives only to absorb that quantisation.
//
// THE TEST IS NOT CONSERVATIVE, and no threshold fixes that. On Sponza 26 pixels
// of 262144 lose part of a thin shadow, and they are not blocks where the taps
// disagreed and the tolerance was too loose -- they are blocks where all four
// taps agree exactly and the truth BETWEEN them differs, because the occluder
// is narrow enough to fall entirely between grid receivers. Every sample says
// lit, so there is nothing for an epsilon to catch. Only a denser grid or a
// genuinely conservative test would see it.
void mbg_mask(ivec2 p, uint tid, vec3 n0, vec3 x0) {
    vec2  g  = (vec2(p) - vec2(float(u_scale) * 0.5)) / float(u_scale);
    ivec2 g0 = ivec2(floor(g));
    vec2  f  = g - vec2(g0);

    if (tid < 4u) {
        int i = int(tid & 1u), j = int(tid >> 1u);
        ivec2 gi = g0 + ivec2(i, j);
        vec4 tap = vec4(0.0);
        if (all(greaterThanEqual(gi, ivec2(0))) && all(lessThan(gi, u_gi_size))) {
            // The same taps, and the same rejection, the bilateral upsample
            // uses -- so the mask agrees with the thing it is standing in for.
            ivec2 sp = min(gi * int(u_scale) + int(u_scale) / 2, u_size - 1);
            vec4 vg = imageLoad(u_vis, gi);
            if (vg.w > 0.5 && texelFetch(u_albedo, sp, 0).a > 0.5) {
                vec3  ns = normalize(texelFetch(u_normal, sp, 0).xyz);
                float ds = texelFetch(u_depth, sp, 0).r;
                vec3  xs = world_from_depth(ds, (vec2(sp) + 0.5) / vec2(u_size),
                                            u_inv_view_proj);
                float wn = max(dot(ns, n0), 0.0); wn *= wn; wn *= wn;
                float wp = max(1.0 - abs(dot(xs - x0, n0)) / max(1e-5, u_plane_tol), 0.0);
                if (wn * wp > 0.0) {
                    tap = vec4(vg.x, vg.y, 1.0, 0.0);
                }
            }
        }
        s_tap[tid] = tap;                     // (frac_e, frac_s, valid, weight)
    }
    barrier();

    if (tid == 0u) {
        vec2 lo = vec2(1.0), hi = vec2(0.0);
        bool usable = true;
        for (uint k = 0u; k < 4u; ++k) {
            vec4 t = s_tap[k];
            // A rejected tap is a geometric edge in the block, so there is no
            // agreement to read -- refine.
            if (t.z < 0.5) { usable = false; continue; }
            lo = min(lo, t.xy);
            hi = max(hi, t.xy);
        }
        // Entirely lit, or entirely shadowed, by every sample. Anything else --
        // disagreement, or agreement on a middle value -- is a penumbra and is
        // computed rather than guessed.
        bvec2 dark = lessThanEqual(hi, vec2(u_mask_eps_e, u_mask_eps_s));
        bvec2 lit  = greaterThanEqual(lo, vec2(1.0) - vec2(u_mask_eps_e, u_mask_eps_s));
        s_mval = vec4(lit.x ? 1.0 : 0.0,
                      lit.y ? 1.0 : 0.0,
                      (!usable || !(dark.x || lit.x)) ? 1.0 : 0.0,
                      (!usable || !(dark.y || lit.y)) ? 1.0 : 0.0);
    }
    barrier();
}

void main() {
    uint pix = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (pix >= uint(u_size.x * u_size.y)) return;

    ivec2 p = ivec2(int(pix) % u_size.x, int(pix) / u_size.x);
    if (texelFetch(u_albedo, p, 0).a <= 0.5) return;

    vec3  N = normalize(texelFetch(u_normal, p, 0).xyz);
    float d = texelFetch(u_depth, p, 0).r;
    vec3  x0 = world_from_depth(d, (vec2(p) + 0.5) / vec2(u_size), u_inv_view_proj);
    vec3  P = x0 + N * u_bias;

    // Ask the grid where the light view is worth running. Both answers are
    // workgroup uniform, which is what lets the branches below skip the
    // barriers inside the loops without splitting the workgroup.
    bool refine_e = true, refine_s = true;
    vec2 gfrac = vec2(0.0);
    if (u_mask != 0u && u_scale > 1u) {
        mbg_mask(p, tid, N, x0);
        gfrac = s_mval.xy;
        refine_e = s_mval.z > 0.5;
        refine_s = s_mval.w > 0.5;
    }

    vec3 E = vec3(0.0);
    lv_jit = vec2(0.0);          // emitter views: their frames already differ per receiver

    // The cheap half: the magnitude is analytic, so a skipped pixel still gets
    // its own cosine falloff and solid angle and only borrows the fraction.
    if (!refine_e) {
        for (uint e = 0u; e < u_emitters; ++e)
            E += mbg_emitter_unshadowed(P, N, mbg_tri(emitters[e]), u_two_sided != 0u,
                                        2.0 * u_bias, u_emissive) * gfrac.x;
    }

    // Uniform loop bound, so the barriers inside it are safe.
    for (uint e = 0u; refine_e && e < u_emitters; ++e) {
        uint ti = emitters[e];
        MbgTri tr = mbg_tri(ti);

        // The magnitude is exact and needs no buffer at all; only the fraction
        // below is estimated. Skip the whole light view when there is nothing to
        // scale -- an emitter below the horizon or turned away.
        vec3 mag = mbg_emitter_unshadowed(P, N, tr, u_two_sided != 0u, 2.0 * u_bias,
                                          u_emissive);
        bool lit = dot(mag, vec3(1.0)) > 0.0 && lv_setup(P, N, tr, 2.0 * u_bias);

        // One texel per thread, visibility resolved in a register: no clear, no
        // shared buffer, no atomics and no barrier around the rasterization.
        // See lv_mass_texel in common/lightview.glsl for why this is the same
        // depth sort with the loops nested the other way.
        // Cull once for this emitter's frustum, then let the texel loop walk
        // only what survived. `lit` is workgroup uniform, so the barriers inside
        // lv_cull cannot split.
        if (lit) lv_cull(tid, 64u, u_cluster_count);
        s_lvred[tid] = vec4(lit ? lv_mass_texel(u_lv_res, N, ti, u_cluster_count,
                                                tid, 64u)
                                : vec2(0.0),
                            0.0, 0.0);
        barrier();
        for (uint r = 32u; r > 0u; r >>= 1u) {
            if (tid < r) s_lvred[tid] += s_lvred[tid + r];
            barrier();
        }

        if (lit) {
            vec2 m = s_lvred[0].xy;
            // No denominator means the frustum caught none of the emitter, which
            // after lv_setup succeeded can only be a sliver below the horizon.
            E += mag * (m.y > 1e-12 ? clamp(m.x / m.y, 0.0, 1.0) : 1.0);
        } else if (dot(mag, vec3(1.0)) > 0.0) {
            // lv_setup gave up: the emitter spans too much of the sky for a
            // bounded frustum. Unoccluded is the right answer for a receiver
            // that close to a light of that size.
            E += mag;
        }
        barrier();
    }

    // --- The sun ---------------------------------------------------------------
    //
    // Per pixel for the same reason the emitters are: it is a direct term, so it
    // carries the sharpest shadow boundaries in the image and the GI grid's
    // 4x4 blocks cannot resolve them. Aimed at the disc, one rasterization, no
    // denominator -- see common/sky.glsl.
    //
    // THE SKY IS NOT HERE, and that is not an omission. Sky visibility is an
    // integral over the whole hemisphere, which is precisely what the secondary
    // cameras already rasterize; a per-pixel version would be a second copy of
    // the same integral at forty times the cost, for a term that is smooth
    // enough that the GI grid resolves it. The sun is the opposite -- one
    // direction, hard-edged -- which is why it is the half that moved here.
    vec3 sun_mag = mbg_sun_unshadowed(N);
    if (dot(sun_mag, vec3(1.0)) > 0.0 && !refine_s) {
        E += sun_mag * gfrac.y;
    } else if (dot(sun_mag, vec3(1.0)) > 0.0) {
        // AN ORDERED DITHER, NOT A ROTATION AND NOT A HASH.
        //
        // lv_setup_dir builds its frame from the sun direction, which is the
        // same everywhere, so every receiver in the scene gets the IDENTICAL
        // texel grid -- and a straight architectural edge lies parallel to one
        // of its axes, so a whole row of texels flips at once. An 8x8 cone then
        // resolves a penumbra in EIGHT steps rather than sixty-four, which on
        // Sponza's floor is plateaus six pixels wide. Cornell never showed it
        // because its penumbrae are a pixel or two across.
        //
        // Spinning per receiver, as the secondary cameras do, would fix the
        // alignment and replace it with grain -- and nothing averages this pass,
        // whose output is the image's sharpest term and goes straight to the
        // screen. A Bayer offset is deterministic and spatially structured
        // instead: neighbouring pixels sample the cone at different sub-texel
        // positions, so the row that flips differs between them and a plateau
        // becomes a fine gradient rather than noise.
        //
        // 4x4 in each axis, so the eight steps become thirty-two and the dither
        // period is four pixels -- below what reads as a pattern at the width
        // these penumbrae actually have.
        const uint bayer[16] = uint[16](0u, 8u, 2u, 10u, 12u, 4u, 14u, 6u,
                                        3u, 11u, 1u, 9u, 15u, 7u, 13u, 5u);
        uint bx = uint(p.x) & 3u, by = uint(p.y) & 3u;
        lv_jit = vec2(float(bayer[by * 4u + bx]) + 0.5,
                      float(bayer[bx * 4u + by]) + 0.5) / 16.0 - 0.5;

        // Not spun per receiver, unlike the secondary cameras'.
        // Nothing averages this pass: its output is the image's sharpest term
        // and goes straight to the screen. An unrotated grid gives a penumbra
        // that ramps smoothly as the receiver moves across it, which is what a
        // shadow edge should look like; a rotated one would trade that ramp for
        // per-pixel grain with no filter downstream to take it back out.
        lv_setup_dir(P, N, u_sun_dir, u_sun_tan_r, lv_near_for(u_inv_far),
                     2.0 * u_bias);
        lv_cull(tid, 64u, u_cluster_count);
        s_lvred[tid] = vec4(lv_mass_disc_texel(u_lv_res, N, u_sun_cos_r,
                                               u_cluster_count, tid, 64u),
                            0.0, 0.0);
        barrier();
        for (uint r = 32u; r > 0u; r >>= 1u) {
            if (tid < r) s_lvred[tid] += s_lvred[tid + r];
            barrier();
        }
        vec2 m = s_lvred[0].xy;
        E += sun_mag * (m.y > 1e-12 ? clamp(m.x / m.y, 0.0, 1.0) : 1.0);
    }

    if (tid == 0u) {
        vec4 cur = imageLoad(u_target, p);
        imageStore(u_target, p, vec4(cur.rgb + E, 1.0));
    }
}
