#version 460 core
layout(local_size_x = 64) in;

// ---------------------------------------------------------------------------
// The direct term, one hemisphere per PIXEL.
//
// Same rasterizer, same depth sort, same visibility ratio as the secondary
// cameras use -- the only thing that changes is the receiver. That is the whole
// point: the GI grid answers for an MBG_SCALE x MBG_SCALE block of pixels, 4x4 by
// default, and a shadow boundary reconstructed from receivers that far apart and
// then bilaterally upsampled is soft no matter how good the upsample is. Nyquist,
// not a filtering failure. Direct lighting is where it shows, because it carries
// the sharpest edges in the image.
//
// So this pass gives the direct term its own receiver. One workgroup per pixel,
// its own hemisphere rasterized from the G-buffer point, visibility from the
// atomicMin winner exactly as everywhere else in this renderer. The penumbra is
// resolved by how many texels the emitter covers; the shadow BOUNDARY is
// resolved per pixel, which is what was missing.
//
// The solve is untouched -- every secondary camera still computes its own direct
// term, because the bounce transport reads it. This only changes what the image
// reads, and the GI grid then carries the indirect residual alone (gather.comp's
// u_split) so nothing is counted twice.
//
// COST is a hemisphere per pixel, i.e. the doc's own section 4.1 reference
// configuration, but for one level and with no children. At 512x512 that is 262k
// workgroups against the 16k the GI grid runs -- and it buys the one term that
// cannot be interpolated. MBG_DIRECT_RES trades the penumbra's smoothness for it.
// ---------------------------------------------------------------------------

#include "scene.glsl"
#include "raster.glsl"
#include "emitter.glsl"
#include "gbuffer.glsl"

layout(std430, binding = 8) readonly buffer MbgEmit { uint   emitters[]; };

layout(binding = 0) uniform sampler2D u_albedo;
layout(binding = 1) uniform sampler2D u_normal;
layout(binding = 3) uniform sampler2D u_depth;

layout(binding = 1, rgba32f) uniform image2D u_target;   // full resolution, (E, 1)

uniform ivec2 u_size;
uniform mat4  u_inv_view_proj;
uniform uint  u_tri_count;
uniform uint  u_emitters;
uniform uint  u_two_sided;
uniform float u_bias;
uniform float u_emissive;


void main() {
    uint pix = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (pix >= uint(u_size.x * u_size.y) || u_emitters == 0u) return;

    ivec2 p = ivec2(int(pix) % u_size.x, int(pix) / u_size.x);
    if (texelFetch(u_albedo, p, 0).a <= 0.5) return;

    vec3  N = normalize(texelFetch(u_normal, p, 0).xyz);
    float d = texelFetch(u_depth, p, 0).r;
    mbg_set_receiver(world_from_depth(d, (vec2(p) + 0.5) / vec2(u_size), u_inv_view_proj),
                     N, u_bias);

    uint texels = u_res * u_res;

    // Emitters alone, then everything: the denominator and the numerator of the
    // visibility ratio, both off the same grid.
    mbg_clear_vis(tid, 64u);
    barrier();
    memoryBarrierShared();
    for (uint i = tid; i < u_emitters; i += 64u) mbg_raster_tri(emitters[i]);
    barrier();
    memoryBarrierShared();
    for (uint i = tid; i < texels; i += 64u) s_emit[i] = s_vis[i];
    barrier();
    memoryBarrierShared();

    mbg_clear_vis(tid, 64u);
    barrier();
    memoryBarrierShared();
    for (uint t = tid; t < u_tri_count; t += 64u) mbg_raster_tri(t);
    barrier();
    memoryBarrierShared();

    vec3 E = vec3(0.0);
    for (uint e = 0u; e < u_emitters; ++e) {
        uint ti = emitters[e];
        vec3 mag = mbg_emitter_unshadowed(g_P, g_N, tris[ti], u_two_sided != 0u,
                                          2.0 * u_bias, u_emissive);
        bool lit = dot(mag, vec3(1.0)) > 0.0;

        s_red2[tid] = vec4(lit ? mbg_emitter_mass(ti, tid, texels, 64u) : vec2(0.0),
                           0.0, 0.0);
        barrier();
        for (uint r = 32u; r > 0u; r >>= 1u) {
            if (tid < r) s_red2[tid] += s_red2[tid + r];
            barrier();
        }
        if (lit) {
            vec2 m = s_red2[0].xy;
            float vis;
            if (m.y > 1e-9) {
                vis = clamp(m.x / m.y, 0.0, 1.0);
            } else {
                vis = mbg_emitter_fallback(tris[ti], u_res, u_inv_far);
            }
            E += mag * vis;
        }
        barrier();
    }

    if (tid == 0u) {
        vec4 cur = imageLoad(u_target, p);
        imageStore(u_target, p, vec4(cur.rgb + E, 1.0));
    }
}
