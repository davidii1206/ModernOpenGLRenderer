#version 460 core
layout(local_size_x = 64) in;

// ---------------------------------------------------------------------------
// The direct term, one light view per PIXEL per emitter.
//
// Two things were wrong with taking the image's direct term off the GI grid, and
// they are independent:
//
//   RECEIVER DENSITY. The grid answers for an MBG_SCALE x MBG_SCALE block of
//   pixels, 4x4 by default, and a shadow boundary reconstructed from receivers
//   that far apart and then bilaterally upsampled is soft however good the
//   upsample is. Nyquist, not a filtering failure. Fixed by giving the direct
//   term its own receiver: one per pixel.
//
//   ANGULAR RESOLUTION ON THE LIGHT. Visibility off a hemisphere buffer is a
//   ratio of texel masses, so its precision is however many texels the emitter
//   covers -- 4 to 29 for Cornell's panel at a 32x32 target. Five or so
//   distinguishable values across a penumbra is a hard line with steps in it,
//   which is what the room's top edges and the box shadows showed. Fixed by
//   pointing the resolution at the light: see common/lightview.glsl.
//
// So this pass does not rasterize a hemisphere at all. Per emitter it fits a
// frustum to that emitter, rasterizes the emitter alone and then the whole scene
// into it, and takes the visible fraction from the two. Same rasterizer, same
// atomicMin depth sort, same read-the-winner rule -- the texels just point at the
// light instead of at the sky.
//
// The solve is untouched: every secondary camera still computes its own direct
// term off its hemisphere, because the bounce transport reads it and a soft
// answer is fine there. This changes only what the IMAGE reads, and the GI grid
// then carries the indirect residual alone (gather.comp's u_split). The
// subtraction stays self-consistent because it subtracts the camera's own direct
// term, whatever estimator produced it.
//
// ADDS INTO the upsampled target: it holds irradiance E directly, so this is a
// read-modify-write and needs no second full-resolution texture.
// ---------------------------------------------------------------------------

#include "scene.glsl"
#include "emitter.glsl"
#include "lightview.glsl"
#include "raster.glsl"
#include "gbuffer.glsl"
#include "sky.glsl"

layout(std430, binding = 8) readonly buffer MbgEmit { uint emitters[]; };

layout(binding = 0) uniform sampler2D u_albedo;
layout(binding = 1) uniform sampler2D u_normal;
layout(binding = 3) uniform sampler2D u_depth;

layout(binding = 1, rgba32f) uniform image2D u_target;   // full resolution, (E, 1)

uniform ivec2 u_size;
uniform mat4  u_inv_view_proj;
uniform uint  u_tri_count;
uniform uint  u_emitters;
uniform uint  u_lv_res;        // light-view target edge
uniform uint  u_two_sided;
uniform float u_bias;
uniform float u_emissive;

shared vec4 s_lvred[64];

void main() {
    uint pix = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (pix >= uint(u_size.x * u_size.y)) return;

    ivec2 p = ivec2(int(pix) % u_size.x, int(pix) / u_size.x);
    if (texelFetch(u_albedo, p, 0).a <= 0.5) return;

    vec3  N = normalize(texelFetch(u_normal, p, 0).xyz);
    float d = texelFetch(u_depth, p, 0).r;
    vec3  P = world_from_depth(d, (vec2(p) + 0.5) / vec2(u_size), u_inv_view_proj) +
              N * u_bias;

    uint texels = u_lv_res * u_lv_res;
    vec3 E = vec3(0.0);

    // Uniform loop bound, so the barriers inside it are safe.
    for (uint e = 0u; e < u_emitters; ++e) {
        uint ti = emitters[e];
        MbgTri tr = tris[ti];

        // The magnitude is exact and needs no buffer at all; only the fraction
        // below is estimated. Skip the whole light view when there is nothing to
        // scale -- an emitter below the horizon or turned away.
        vec3 mag = mbg_emitter_unshadowed(P, N, tr, u_two_sided != 0u, 2.0 * u_bias,
                                          u_emissive);
        bool lit = dot(mag, vec3(1.0)) > 0.0 && lv_setup(P, N, tr, 2.0 * u_bias);

        if (lit) {
            for (uint i = tid; i < texels; i += 64u) {
                s_lv[i] = MBG_EMPTY;
                s_lv_e[i] = MBG_EMPTY;
            }
            barrier();
            memoryBarrierShared();

            // The emitter alone: the denominator, i.e. where it would reach.
            lv_raster_tri(ti, u_lv_res, u_inv_far, true);
            // Everything: the numerator, i.e. what actually got there.
            for (uint t = tid; t < u_tri_count; t += 64u)
                lv_raster_tri(t, u_lv_res, u_inv_far, false);
            barrier();
            memoryBarrierShared();
        }

        s_lvred[tid] = vec4(lit ? lv_mass(u_lv_res, N, tid, texels, 64u) : vec2(0.0),
                            0.0, 0.0);
        barrier();
        for (uint r = 32u; r > 0u; r >>= 1u) {
            if (tid < r) s_lvred[tid] += s_lvred[tid + r];
            barrier();
        }

        if (lit) {
            vec2 m = s_lvred[0].xy;
            // No denominator means the frustum caught none of the emitter, which
            // after lv_setup succeeded can only be a sliver below the horizon.
            E += mag * (m.y > 1e-12 ? clamp(m.x / m.y, 0.0, 1.0) : 1.0);
        } else if (dot(mag, vec3(1.0)) > 0.0) {
            // lv_setup gave up: the emitter spans too much of the sky for a
            // bounded frustum. Unoccluded is the right answer for a receiver
            // that close to a light of that size.
            E += mag;
        }
        barrier();
    }

    // --- The sun ---------------------------------------------------------------
    //
    // Per pixel for the same reason the emitters are: it is a direct term, so it
    // carries the sharpest shadow boundaries in the image and the GI grid's
    // 4x4 blocks cannot resolve them. Aimed at the disc, one rasterization, no
    // denominator -- see common/sky.glsl.
    //
    // THE SKY IS NOT HERE, and that is not an omission. Sky visibility is an
    // integral over the whole hemisphere, which is precisely what the secondary
    // cameras already rasterize; a per-pixel version would be a second copy of
    // the same integral at forty times the cost, for a term that is smooth
    // enough that the GI grid resolves it. The sun is the opposite -- one
    // direction, hard-edged -- which is why it is the half that moved here.
    vec3 sun_mag = mbg_sun_unshadowed(N);
    if (dot(sun_mag, vec3(1.0)) > 0.0) {
        // Deliberately NOT spun per receiver, unlike the secondary cameras'.
        // Nothing averages this pass: its output is the image's sharpest term
        // and goes straight to the screen. An unrotated grid gives a penumbra
        // that ramps smoothly as the receiver moves across it, which is what a
        // shadow edge should look like; a rotated one would trade that ramp for
        // per-pixel grain with no filter downstream to take it back out.
        lv_setup_dir(P, N, u_sun_dir, u_sun_tan_r, lv_near_for(u_inv_far),
                     2.0 * u_bias);
        for (uint i = tid; i < texels; i += 64u) s_lv[i] = MBG_EMPTY;
        barrier();
        memoryBarrierShared();
        for (uint t = tid; t < u_tri_count; t += 64u)
            lv_raster_tri(t, u_lv_res, u_inv_far, false);
        barrier();
        memoryBarrierShared();

        s_lvred[tid] = vec4(lv_mass_disc(u_lv_res, N, u_sun_cos_r, tid, texels, 64u),
                            0.0, 0.0);
        barrier();
        for (uint r = 32u; r > 0u; r >>= 1u) {
            if (tid < r) s_lvred[tid] += s_lvred[tid + r];
            barrier();
        }
        vec2 m = s_lvred[0].xy;
        E += sun_mag * (m.y > 1e-12 ? clamp(m.x / m.y, 0.0, 1.0) : 1.0);
    }

    if (tid == 0u) {
        vec4 cur = imageLoad(u_target, p);
        imageStore(u_target, p, vec4(cur.rgb + E, 1.0));
    }
}
