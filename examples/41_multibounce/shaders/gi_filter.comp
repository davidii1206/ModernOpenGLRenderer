#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

// ---------------------------------------------------------------------------
// Edge-aware denoise of the GI grid. DISPLAY ONLY: the solve never reads it.
//
// The other half of finding 14's answer. Rotating each receiver's tangent frame
// turns the quadrature's banding into spatial noise (common/raster.glsl); this
// pass is what then removes the noise. Neither works alone -- filtering a
// coherent pattern just blurs the pattern, and decorrelating without averaging
// trades bands for grain.
//
// It is safe to blur here and nowhere else because of the split in finding 11:
// the grid carries the INDIRECT RESIDUAL alone, and indirect irradiance is low
// frequency by nature. The direct term, which carries every sharp edge in the
// image, is added afterwards at full resolution and never touches this.
//
// A-trous: each iteration doubles the tap spacing, so three passes of a 5x5
// kernel reach as far as a 17x17 one for a ninth of the taps. Weights are the
// neighbour's normal agreement and its distance from this receiver's tangent
// plane, which is what stops it averaging across a corner or a silhouette.
//
// THE TAP WEIGHTS ARE BINOMIAL AND THAT IS NOT COSMETIC. An a-trous iteration
// with spacing 2^k samples every 2^k-th cell, so it has UNITY GAIN at every
// frequency that aliases onto DC at that spacing -- starting with the grid's own
// Nyquist, period 2 cells. The construction only works if each iteration
// annihilates the frequencies the next, more dilated one will alias; that is the
// entire reason the literature's kernel is the B3 spline (1,4,6,4,1)/16, whose
// response is exactly zero at Nyquist.
//
// This pass used to weight its taps 1/(1 + dx^2 + dy^2), described in the comment
// it replaced as "B3-spline-ish". It is not: along one axis that is
// (0.2, 0.5, 1, 0.5, 0.2), which passes 17% of Nyquist instead of 0%, and the
// dilated iterations then pass 100% of it. So every iteration after the first
// attenuated the smooth part of the signal and left the period-2 part alone,
// which is amplification in everything but name -- measurably so: on the ceiling
// at three bounces, one iteration gave a row-noise sigma of 0.09, three gave
// 0.22 and five gave 0.71, with a spectral peak sitting exactly on two grid
// cells. That is the horizontal streaking (implementation.md, finding 17).
//
// C(2R, R+d) generalizes the B3 spline to any radius -- it IS (1,4,6,4,1) at
// R=2 -- and its response is cos^2R(w/2), identically zero at Nyquist for every
// R. Separable, because the null has to hold along each axis independently.
//
// AND THE KERNEL HAS TO STAY WHOLE, which is the other half of the same problem.
// The usual edge-aware formulation drops a rejected tap and renormalizes by the
// weights that are left -- and a truncated binomial is not a binomial, so its
// null is gone. On the ceiling that matters constantly: it is a thin band in
// screen space, the dilated iterations reach +-8 cells, and taps that far out
// land on the back wall, on a side wall or on the sky. So the null broke exactly
// where the artifact was, some Nyquist leaked, and the next iteration passed it
// at unity gain.
//
// Instead, a rejected tap is replaced by THE CENTRE'S OWN VALUE rather than
// removed: the kernel is always the full binomial, the normalization is always
// its full sum, and the null holds everywhere. It is also the right answer on
// its own terms -- a tap the edge test rejects carries no information about this
// receiver, and the least-biased thing to put there is what this receiver
// already has. Nothing leaks across the edge, because nothing from the far side
// is read. The cost is that a cell near a boundary is smoothed less than one in
// the middle of a surface, which is honest: there are fewer samples there.
//
// This is example 40's surfel_filter.comp with its object-space cache swapped
// for a screen-space grid, and it inherits the drawback 40 names: a filter width
// in pixels is a different width in world units at different depths, so a
// distant wall is denoised harder than a near one. The fix is the object-space
// cache of doc section 7.2, which is variant B's to build.
// ---------------------------------------------------------------------------

#include "gbuffer.glsl"

layout(binding = 0, rgba32f) uniform readonly  image2D u_src;
layout(binding = 1, rgba32f) uniform writeonly image2D u_dst;

layout(binding = 0) uniform sampler2D u_albedo;
layout(binding = 1) uniform sampler2D u_normal;
layout(binding = 3) uniform sampler2D u_depth;

uniform ivec2 u_gi_size;
uniform ivec2 u_size;
uniform uint  u_scale;
uniform mat4  u_inv_view_proj;
uniform int   u_stride;       // a-trous tap spacing for this iteration
uniform int   u_radius;       // taps per side
uniform float u_plane_tol;    // world units

// The full-resolution G-buffer pixel a GI cell was sampled at -- the same
// mapping place.comp uses, so the filter tests the receivers the solve actually
// placed rather than an interpolation of them.
// C(2R, R+d), built multiplicatively. R is 1..4 here, so this is exact in float.
float gi_tap_weight(int d, int R) {
    int k = R + d;
    float c = 1.0;
    for (int i = 0; i < k; ++i) c = c * float(2 * R - i) / float(i + 1);
    return c;
}

ivec2 gi_to_pixel(ivec2 g) {
    return min(g * int(u_scale) + int(u_scale) / 2, u_size - 1);
}

bool gi_receiver(ivec2 g, out vec3 pos, out vec3 nrm) {
    ivec2 s = gi_to_pixel(g);
    if (texelFetch(u_albedo, s, 0).a <= 0.5) return false;
    nrm = normalize(texelFetch(u_normal, s, 0).xyz);
    pos = world_from_depth(texelFetch(u_depth, s, 0).r,
                           (vec2(s) + 0.5) / vec2(u_size), u_inv_view_proj);
    return true;
}

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x >= u_gi_size.x || g.y >= u_gi_size.y) return;

    vec3 p0, n0;
    if (!gi_receiver(g, p0, n0)) { imageStore(u_dst, g, imageLoad(u_src, g)); return; }

    vec3  c0  = imageLoad(u_src, g).rgb;
    vec3  acc = vec3(0.0);
    float wsum = 0.0;
    for (int dy = -u_radius; dy <= u_radius; ++dy) {
        float wy = gi_tap_weight(dy, u_radius);
        for (int dx = -u_radius; dx <= u_radius; ++dx) {
            // The tap weight is unconditional: every position in the kernel
            // contributes, so the kernel stays binomial and so does its null.
            float wk = wy * gi_tap_weight(dx, u_radius);
            wsum += wk;

            // How much of this tap is usable. 0 means "no information here",
            // and what goes in its place is this receiver's own value.
            ivec2 q = g + ivec2(dx, dy) * u_stride;
            float conf = 0.0;
            vec3  val = c0;
            if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, u_gi_size))) {
                vec3 p1, n1;
                if (gi_receiver(q, p1, n1)) {
                    float wn = max(dot(n0, n1), 0.0);
                    wn *= wn; wn *= wn;                            // ^4
                    float wp = max(1.0 - abs(dot(p1 - p0, n0)) / u_plane_tol, 0.0);
                    conf = wn * wp;
                    if (conf > 0.0) val = mix(c0, imageLoad(u_src, q).rgb, conf);
                }
            }
            acc += val * wk;
        }
    }

    imageStore(u_dst, g, vec4(acc / wsum, 1.0));
}
