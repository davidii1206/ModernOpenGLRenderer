#version 460 core
layout(local_size_x = 64) in;

// ---------------------------------------------------------------------------
// Close one level of the recursion: add the children's irradiance into their
// parent's, and (for level 1) scatter the result into the GI image.
//
//     E_parent = E_direct + SUM over tiles of ( albedo-weighted mass * E_child / PI )
//
// The /PI is the one in L_out = L_e + albedo * E / PI and this is the ONLY place
// in the example where it appears -- doc-adjacent example 40 makes the same
// point in shaders/common/brdf.glsl, and for the same reason: a missing or
// doubled PI is consistent across near and far, so no internal cross-check
// catches it and only a reference image does.
//
// The albedo and the quadrature weights were already folded into child_w by the
// spawn (raster.comp), so this kernel is a small fixed loop with no scene access
// at all. Levels resolve deepest-first: level L is terminal, then L-1 reads it,
// down to level 1.
// ---------------------------------------------------------------------------

#include "scene.glsl"

layout(std430, binding = 3) buffer          MbgIrrad  { vec4 irradiance[]; };
layout(std430, binding = 5) readonly buffer MbgChildW { vec4 child_w[]; };
layout(std430, binding = 6) readonly buffer MbgChildE { vec4 child_e[]; };
layout(std430, binding = 10) readonly buffer MbgChildD { vec4 child_d[]; };
layout(std430, binding = 9)  readonly buffer MbgDirect { vec4 direct_in[]; };

layout(binding = 0, rgba32f) uniform image2D u_gi;

uniform uint  u_cam_count;
uniform uint  u_children;    // per camera; 0 on a terminal level or a 1-bounce run
uniform uint  u_write;       // 1 = this is level 1: scatter into the GI image
uniform uint  u_cursor;      // GI pixel index of camera 0 of this chunk
uniform ivec2 u_gi_size;
uniform uint  u_split;       // 1 = scatter E MINUS the direct term (direct_pixel.comp
                             //     re-adds it per pixel); 0 = scatter all of E

void main() {
    uint cam = gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 64u + gl_GlobalInvocationID.x;
    if (cam >= u_cam_count) return;

    vec3 E = irradiance[cam].xyz;
    for (uint b = 0u; b < u_children; ++b) {
        uint slot = cam * u_children + b;
        vec4 m_ind = child_w[slot * 3u + 0u];
        if (m_ind.w == 0.0) continue;
        vec4 m_emit = child_w[slot * 3u + 1u];
        vec4 m_sun  = child_w[slot * 3u + 2u];
        vec4 d0 = child_d[slot * 2u + 0u];   // (total direct, emitter fraction)
        vec4 d1 = child_d[slot * 2u + 1u];   // (the sun's share, sun fraction)

        // The direct half is reconstructed per texel by the parent and only
        // SCALED by what this child measured about visibility; the indirect half
        // is the child's irradiance with its own direct term removed, which is
        // the smooth part that a tile can legitimately stand in for. See the
        // mass accumulation in raster.comp.
        //
        // ONE SCALE FACTOR PER LIGHT CHARACTER. An emitter's visible fraction is
        // a wide soft penumbra and survives being sampled once per tile; the
        // sun's is 0 or 1 across a couple of centimetres and does not. Blending
        // them into a single fraction let the sun's variance into the panel's
        // term, which is most of the light in the room -- see raster.comp.
        vec3 rest = max(child_e[slot].xyz - d0.xyz, vec3(0.0));
        E += (m_ind.xyz * rest + m_emit.xyz * d0.w + m_sun.xyz * d1.w)
             * 0.31830988618379;
    }
    irradiance[cam] = vec4(E, 1.0);

    if (u_write != 0u) {
        // The residual, not the total, when the image's direct term is coming
        // from direct_pixel.comp. The camera's own direct term stays in
        // irradiance[] either way, because the bounce transport above reads it.
        vec3 img = u_split != 0u ? max(E - direct_in[cam * 2u].xyz, vec3(0.0)) : E;
        uint pix = u_cursor + cam;
        if (pix < uint(u_gi_size.x * u_gi_size.y))
            imageStore(u_gi, ivec2(int(pix) % u_gi_size.x, int(pix) / u_gi_size.x),
                       vec4(img, 1.0));
    }
}
