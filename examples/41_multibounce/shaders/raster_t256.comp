#version 460 core
// perf.glsl reads the shader clock; an #extension directive is only legal
// before any code, and an include expands in the middle of one -- so it is
// declared here, exactly as example 38's ray kernel declares it.
#extension GL_ARB_shader_clock : enable
// Up to 16x16 -- the default schedule's level 1. 2 KB.
#define MBG_MAX_TEXELS 256
#include "raster_body.glsl"
