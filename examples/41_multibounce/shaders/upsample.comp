#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

// ---------------------------------------------------------------------------
// GI grid -> full resolution, joint bilateral on normal and plane distance.
//
// At MBG_SCALE=1 every full-res pixel has its own camera and this is a copy. Above
// that it is the only place in the example where a receiver reads irradiance
// computed at a DIFFERENT point, which makes it the one component whose error is
// the reuse error of doc section 4.2 -- at a radius of a few pixels rather than
// the tens of centimetres section 8.1 is about. The plane test is what stops it
// leaking across a depth discontinuity; without it the bright floor bleeds over
// the dark box edge in exactly the way probe GI does.
// ---------------------------------------------------------------------------

#include "gbuffer.glsl"

layout(binding = 0) uniform sampler2D u_albedo;
layout(binding = 1) uniform sampler2D u_normal;
layout(binding = 3) uniform sampler2D u_depth;

layout(binding = 0, rgba32f) uniform readonly  image2D u_gi;    // GI resolution, (E, 1)
layout(binding = 1, rgba32f) uniform writeonly image2D u_out;   // full resolution

uniform ivec2 u_size;
uniform ivec2 u_gi_size;
uniform uint  u_scale;
uniform mat4  u_inv_view_proj;
uniform float u_plane_tol;    // world units

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= u_size.x || p.y >= u_size.y) return;

    if (texelFetch(u_albedo, p, 0).a <= 0.5) { imageStore(u_out, p, vec4(0.0)); return; }
    if (u_scale == 1u) { imageStore(u_out, p, imageLoad(u_gi, p)); return; }

    vec3  n0 = normalize(texelFetch(u_normal, p, 0).xyz);
    float d0 = texelFetch(u_depth, p, 0).r;
    vec3  x0 = world_from_depth(d0, (vec2(p) + 0.5) / vec2(u_size), u_inv_view_proj);

    // GI sample (gx,gy) was taken at full-res pixel gx*scale + scale/2, so the
    // continuous GI coordinate of this pixel is (p - scale/2) / scale.
    vec2  g  = (vec2(p) - vec2(float(u_scale) * 0.5)) / float(u_scale);
    ivec2 g0 = ivec2(floor(g));
    vec2  f  = g - vec2(g0);

    vec3  acc = vec3(0.0);
    float wsum = 0.0;
    for (int j = 0; j <= 1; ++j) {
        for (int i = 0; i <= 1; ++i) {
            ivec2 gi = clamp(g0 + ivec2(i, j), ivec2(0), u_gi_size - 1);
            ivec2 sp = min(gi * int(u_scale) + int(u_scale) / 2, u_size - 1);
            if (texelFetch(u_albedo, sp, 0).a <= 0.5) continue;

            vec3  ns = normalize(texelFetch(u_normal, sp, 0).xyz);
            float ds = texelFetch(u_depth, sp, 0).r;
            vec3  xs = world_from_depth(ds, (vec2(sp) + 0.5) / vec2(u_size), u_inv_view_proj);

            float wb = (i == 0 ? 1.0 - f.x : f.x) * (j == 0 ? 1.0 - f.y : f.y);
            float wn = max(dot(ns, n0), 0.0);
            wn *= wn; wn *= wn;                                   // ^4
            float wp = max(1.0 - abs(dot(xs - x0, n0)) / u_plane_tol, 0.0);
            float w = wb * wn * wp;
            if (w <= 0.0) continue;
            acc  += imageLoad(u_gi, gi).rgb * w;
            wsum += w;
        }
    }

    // Every neighbour rejected: fall back to the nearest sample rather than
    // leaving a hole. This happens on thin geometry and at silhouettes, and it is
    // the honest failure -- the alternative, relaxing the plane test, leaks.
    if (wsum <= 1e-8) {
        ivec2 gi = clamp(ivec2(round(g)), ivec2(0), u_gi_size - 1);
        imageStore(u_out, p, vec4(imageLoad(u_gi, gi).rgb, 1.0));
        return;
    }
    imageStore(u_out, p, vec4(acc / wsum, 1.0));
}
