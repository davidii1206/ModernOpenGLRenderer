#version 460 core
layout(local_size_x = 256) in;

// ---------------------------------------------------------------------------
// The far field's multipole: what each 4x4x4 macro block emits, per DIRECTION.
//
// Order 0 -- one mean radiance per block -- is what this was, and finding 56
// measured what it costs. A block holds the lit inner face of a wall and its
// unlit outer face and reports their average, so the far field is
// direction-blind, and the seed-to-seed noise it produces is 0.107 of the mean
// against 0.038 with the far field switched off entirely. It is the dominant
// noise source in the cache, and no amount of spatial interpolation fixes it:
// blending a direction-blind average across neighbours lost 40% of the scene's
// energy and made the noise worse.
//
// So store a direction instead. A Lambertian surfel of outgoing radiance L and
// normal n contributes L * max(dot(n, w), 0) to the block's radiant intensity in
// direction w, and the clamped cosine lobe projects onto spherical harmonics
// with the standard convolution coefficients A_l -- pi at band 0, 2pi/3 at band
// 1. So the block's numerator and denominator
//
//     N(w) = SUM_i L_i * max(dot(n_i, w), 0)
//     D(w) = SUM_i       max(dot(n_i, w), 0)
//
// both accumulate as SUM_i (L_i or 1) * A_l * Y_lm(n_i), and the radiance a
// receiver in direction w should see is N(w) / D(w) -- the L-weighted mean over
// the surfels that actually face it, rather than over all of them.
//
// Band 0 alone reduces to exactly the old mean: N_00/D_00 = SUM L_i / n. That is
// what makes u_far_order a clean A/B rather than two code paths.
//
// Signed coefficients, so int atomics and fixed point. Sixteen ints a block --
// twelve for N over three channels, four for D -- is 64 bytes, about 16 MB for
// Sponza's macro grid.
// ---------------------------------------------------------------------------

#include "surfel.glsl"

layout(std430, binding = 6)  readonly buffer Lout   { vec4 lout[]; };
layout(std430, binding = 24)          buffer BlkSH  { int  blk[]; };

uniform uint  u_count;
uniform uint  u_words;        // blocks * kBlkWords
uniform vec3  u_grid_min;
uniform ivec3 u_macro_res;
uniform float u_macro_cell;
uniform uint  u_clear;        // 1 = zero the buffer, 0 = accumulate

const float kFixed = 65536.0;

void main() {
    const uint i = gl_GlobalInvocationID.x;

    if (u_clear != 0u) {
        if (i < u_words) blk[i] = 0;
        return;
    }
    if (i >= u_count) return;

    const ivec3 m = ivec3(floor((s_pos_rad[i].xyz - u_grid_min) / u_macro_cell));
    if (any(lessThan(m, ivec3(0))) || any(greaterThanEqual(m, u_macro_res))) return;
    const uint mb = uint(m.x) + uint(u_macro_res.x) *
                    (uint(m.y) + uint(u_macro_res.y) * uint(m.z));

    const vec3 L = max(lout[i].rgb, vec3(0.0));
    const vec3 n = surfel_normal(i);

    // Y_00 and the three band-1 harmonics, each already multiplied by its
    // convolution coefficient A_l.
    float y[4];
    y[0] = 0.2820947918 * 3.14159265358979;              // A_0 * Y_00
    const float a1 = 0.4886025119 * (2.0 * 3.14159265358979 / 3.0);
    y[1] = a1 * n.y;
    y[2] = a1 * n.z;
    y[3] = a1 * n.x;

    const uint base = mb * kBlkWords;
    for (int k = 0; k < 4; ++k) {
        atomicAdd(blk[base + uint(k) * 4u + 0u], int(L.r * y[k] * kFixed));
        atomicAdd(blk[base + uint(k) * 4u + 1u], int(L.g * y[k] * kFixed));
        atomicAdd(blk[base + uint(k) * 4u + 2u], int(L.b * y[k] * kFixed));
        atomicAdd(blk[base + uint(k) * 4u + 3u], int(       y[k] * kFixed));
    }
}
