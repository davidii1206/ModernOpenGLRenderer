#version 460 core
layout(local_size_x = 256) in;

layout(std430, binding = 8) buffer Radiance { vec4 rad[]; };

uniform uint u_count;
uniform uint u_level_start;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_count) return;

    uint node = u_level_start + i;
    vec3 sum = vec3(0.0);
    for (int c = 0; c < 8; ++c)
        sum += rad[8u * node + 1u + uint(c)].rgb;
    rad[node] = vec4(sum / 8.0, 1.0);
}
