#version 460 core
layout(local_size_x = 256) in;

layout(std430, binding = 5) buffer Spheres { vec4 sphere_buf[]; };
layout(std430, binding = 9) buffer Cones   { vec4 cone_buf[]; };

uniform uint u_count;
uniform uint u_level_start;

void merge_cone(vec3 a1, float w1, vec3 a2, float w2, out vec3 axis, out float cw) {
    float b1 = acos(clamp(w1, -1.0, 1.0));
    float b2 = acos(clamp(w2, -1.0, 1.0));
    float ang = acos(clamp(dot(a1, a2), -1.0, 1.0));
    if (ang + b1 + b2 >= 3.141592653589793 - 1e-5 || length(a1 + a2) < 1e-4) {
        axis = a1; cw = -1.0;
    } else {
        axis = normalize(a1 + a2);
        cw = cos((ang + b1 + b2) * 0.5);
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_count) return;

    uint node = u_level_start + i;

    // Ritter bounding sphere over the 8 child spheres (mirrors CPU build).
    vec3 c = sphere_buf[8u * node + 1u].xyz;
    float r = sphere_buf[8u * node + 1u].w;
    vec3 axis = vec3(0.0);
    float cw = 1.0;
    bool first = true;
    for (int ch = 0; ch < 8; ++ch) {
        uint child = 8u * node + 1u + uint(ch);
        vec3 cc = sphere_buf[child].xyz;
        float cr = sphere_buf[child].w;
        float d = length(cc - c);
        if (d + cr > r) {
            float nr = (r + d + cr) * 0.5;
            c = (d > 1e-12) ? c + (cc - c) * (nr - r) / d : c;
            r = nr;
        }

        vec3 ca = cone_buf[child].xyz;
        if (first) { axis = ca; cw = cone_buf[child].w; first = false; }
        else merge_cone(axis, cw, ca, cone_buf[child].w, axis, cw);
    }

    sphere_buf[node] = vec4(c, r);
    cone_buf[node]   = vec4(axis, cw);
}
