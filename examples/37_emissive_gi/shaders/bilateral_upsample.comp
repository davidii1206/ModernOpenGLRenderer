#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D u_low;      // low-res indirect
layout(binding = 1) uniform sampler2D u_hi_pos;   // full-res G-buffer position
layout(binding = 2) uniform sampler2D u_hi_nrm;   // full-res G-buffer normal

layout(binding = 0, rgba16f) writeonly uniform image2D u_out;

uniform ivec2 u_low_size;
uniform ivec2 u_hi_size;
uniform float u_depth_sigma;
uniform float u_normal_exp;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= u_hi_size.x || p.y >= u_hi_size.y) return;

    vec3 pos = texelFetch(u_hi_pos, p, 0).xyz;
    vec3 nrm = normalize(texelFetch(u_hi_nrm, p, 0).xyz);

    // Center of this pixel in low-res texel space.
    vec2 lc = (vec2(p) + 0.5) * vec2(u_low_size) / vec2(u_hi_size);
    ivec2 l0 = ivec2(floor(lc - 0.5));
    ivec2 l1 = l0 + ivec2(1, 1);

    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    float two_sigma2 = 2.0 * u_depth_sigma * u_depth_sigma;

    for (int dy = 0; dy <= 1; ++dy) {
        for (int dx = 0; dx <= 1; ++dx) {
            ivec2 lt = clamp(ivec2(l0.x + dx, l0.y + dy), ivec2(0), u_low_size - 1);
            // Reference full-res location of this low-res texel center.
            ivec2 hc = ivec2((vec2(lt) + 0.5) * vec2(u_hi_size) / vec2(u_low_size));
            hc = clamp(hc, ivec2(0), u_hi_size - 1);
            vec3 rpos = texelFetch(u_hi_pos, hc, 0).xyz;
            vec3 rnrm = normalize(texelFetch(u_hi_nrm, hc, 0).xyz);

            float dz = pos.z - rpos.z;
            float wd = exp(-dz * dz / two_sigma2);
            float wn = pow(max(dot(nrm, rnrm), 0.0), u_normal_exp);

            float w = wd * wn;
            sum += texelFetch(u_low, lt, 0).rgb * w;
            wsum += w;
        }
    }

    vec3 col = (wsum > 1e-6) ? (sum / wsum) : vec3(0.0);
    imageStore(u_out, p, vec4(col, 1.0));
}
