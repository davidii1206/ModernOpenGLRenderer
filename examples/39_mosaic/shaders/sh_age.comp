#version 460 core
layout(local_size_x = 256) in;

// Ages the persistent cache. Every source surfel not refreshed by this frame's
// gather gets one frame older, which is what lets the scheduler's priority pull
// the neglected tail back in. The gather resets age to 0 when it updates a
// surfel.

#include "sh.glsl"

layout(std430, binding = 0) buffer ShCache { vec4 sh_cache[]; };

uniform uint u_surfel_count;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_surfel_count) return;
    vec4 v1 = sh_cache[i * SH_STRIDE + 1u];
    sh_cache[i * SH_STRIDE + 1u] = vec4(v1.xyz, min(v1.w + 1.0, 1e6));
}
