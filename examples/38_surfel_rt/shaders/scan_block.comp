#version 460 core
layout(local_size_x = 256) in;

// Pass 2a: block-local exclusive prefix sum of cell_count -> cell_start.
// Also writes each block's total to bsum[block].
// u_n_from_buf: the ray-stream compaction scans GPU-sized flag arrays with
// an INDIRECT dispatch (the CPU never reads the count); n then comes from
// nval[0] (binding 3) instead of the uniform.
layout(std430, binding = 0) readonly buffer CellCount { uint cell_count[]; };
layout(std430, binding = 1) buffer CellStart { uint cell_start[]; };
layout(std430, binding = 2) buffer BlockSum { uint bsum[]; };
layout(std430, binding = 3) readonly buffer NVal { uint nval[]; };   // bound only when u_n_from_buf

uniform uint u_n;          // this level's grid volume (ignored when u_n_from_buf)
uniform uint u_cnt_off;    // cell_count segment offset
uniform uint u_start_off;  // cell_start segment offset
uniform int  u_n_from_buf; // 1 = n = nval[0]

shared uint s[256];

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;
    uint bid = gl_WorkGroupID.x;
    uint n = (u_n_from_buf != 0) ? nval[0] : u_n;

    s[lid] = (gid < n) ? cell_count[u_cnt_off + gid] : 0u;
    barrier();

    for (uint stride = 1u; stride < 256u; stride <<= 1u) {
        uint v = 0u;
        if (lid >= stride) v = s[lid - stride];
        barrier();
        s[lid] += v;
        barrier();
    }

    uint excl = (lid == 0u) ? 0u : s[lid - 1u];
    if (gid < n) cell_start[u_start_off + gid] = excl;
    if (lid == 255u) bsum[bid] = s[lid];
}
