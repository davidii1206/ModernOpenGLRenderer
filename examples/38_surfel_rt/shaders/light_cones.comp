#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

// Diffuse GI gather: half-resolution, 5 cosine-weighted cones per pixel
// (VCT layout — normal + 4 tilted), marched through the surfel pyramid with
// occupancy transmittance. Reads the baked radiance cache (direct light +
// one emissive bounce); outputs half-res irradiance + transmittance (AO) for
// the bilateral upsample in display.frag. Mirror pixels and background are
// skipped — mirrors shade through their ray-traced radiance gather.
layout(binding = 1) uniform sampler2D gbuf_pos;   // RGBA16F world position
layout(binding = 2) uniform sampler2D gbuf_nrm;   // RGBA16F world normal
layout(binding = 3) uniform sampler2D gbuf_alb;   // RGBA8 albedo + mirror flag

layout(std430, binding = 11) readonly buffer CellMask { uint cell_mask[]; };
layout(std430, binding = 16) readonly buffer RdrPN { vec4 rdr_pn[]; };
layout(std430, binding = 18) readonly buffer CombSC { uvec2 comb_sc[]; };
layout(std430, binding = 19) readonly buffer CombList { uint comb_list[]; };
layout(std430, binding = 39) readonly buffer SurfRad { vec4 surf_rad[]; };  // baked cache
layout(std430, binding = 40) readonly buffer MegaRad { vec4 mega_rad[]; };

layout(binding = 5, rgba16f) writeonly uniform image2D u_gi_half;

uniform vec3  u_grid_min;
uniform float u_inv_cell;
uniform ivec3 u_grid_res;
uniform vec3  u_l_min[4];
uniform float u_l_inv_cell[4];
uniform ivec3 u_l_res[4];
uniform uint  u_l_cnt_off[4];
uniform uint  u_l_packed_off[4];
uniform uint  u_l_mask_off[4];
uniform uint  u_l_num[4];
uniform int   u_levels;
uniform uint  u_cnt_off;
uniform uint  u_packed_off;
uniform uint  u_mega_flag;
uniform ivec2 u_half_size;
uniform float u_max_t;
uniform int   u_cone_count;   // 1..5 (center cone only up to all five)
uniform float u_gain;         // irradiance scale (Cornell-look tuning)

#define kConeLevels 4

bool l_in_bounds(int l, ivec3 c) {
    return c.x >= 0 && c.y >= 0 && c.z >= 0 &&
           c.x < u_l_res[l].x && c.y < u_l_res[l].y && c.z < u_l_res[l].z;
}

bool cell_occupied(int l, uint ci) {
    return (cell_mask[u_l_mask_off[l] + (ci >> 5)] >> (ci & 31u)) != 0u;
}

vec4 cone_march(vec3 pos, vec3 dir, float tan_half, float r0) {
    vec3 rad = vec3(0.0);
    float T = 1.0;
    float t = r0 * 2.0;
    for (int s = 0; s < 64 && t < u_max_t && T > 0.02; ++s) {
        float R = max(r0, t * tan_half) + r0;
        vec3 p = pos + dir * (t + R);
        int l = -1;
        for (int li = kConeLevels - 1; li >= 0; --li) {
            if (u_l_num[li] == 0u) continue;
            float cell = 1.0 / u_l_inv_cell[li];
            if (cell < R) continue;
            vec3 g = (p - u_l_min[li]) * u_l_inv_cell[li];
            if (any(lessThan(g, vec3(0.0))) || any(greaterThanEqual(g, vec3(u_l_res[li])))) continue;
            l = li;
            break;
        }
        if (l < 0 && u_l_num[0] != 0u) {
            vec3 g0 = (p - u_l_min[0]) * u_l_inv_cell[0];
            bool inside0 = !any(lessThan(g0, vec3(0.0))) && !any(greaterThanEqual(g0, vec3(u_l_res[0])));
            if (inside0) l = 0;
        }
        if (l < 0) { t += R; continue; }
        float cell = 1.0 / u_l_inv_cell[l];
        ivec3 ic = clamp(ivec3(floor((p - u_l_min[l]) * u_l_inv_cell[l])), ivec3(0), u_l_res[l] - 1);
        float Rs = min(R, 4.0 * cell);
        int lat = int(min(ceil(Rs / cell - 0.5), 4.0));
        uint off = u_l_cnt_off[l], poff = u_l_packed_off[l];
        for (int dz = -lat; dz <= lat; ++dz)
        for (int dy = -lat; dy <= lat; ++dy)
        for (int dx = -lat; dx <= lat; ++dx) {
            ivec3 lc = ic + ivec3(dx, dy, dz);
            if (!l_in_bounds(l, lc)) continue;
            uint ci = uint(lc.x + u_l_res[l].x * (lc.y + u_l_res[l].y * lc.z));
            if (!cell_occupied(l, ci)) continue;
            uvec2 csc = comb_sc[off + ci];
            uint cb = poff + csc.x;
            for (uint k = 0u; k < csc.y; ++k) {
                uint e = comb_list[cb + k];
                vec4 pc;
                vec4 rn;
                vec3 sr;
                if ((e & u_mega_flag) != 0u) {
                    uint mi = e & ~u_mega_flag;
                    pc = rdr_pn[2u * mi];
                    rn = rdr_pn[2u * mi + 1u];
                    sr = mega_rad[mi].rgb;
                } else {
                    uint pi = e;
                    pc = rdr_pn[2u * pi];
                    rn = rdr_pn[2u * pi + 1u];
                    sr = surf_rad[pi].rgb;
                }
                float facing = clamp(dot(rn.xyz, -dir), 0.0, 1.0);
                float rr = pc.w / max(Rs, 1e-4);
                float cov = min(1.0, rr * rr) * facing;
                rad += sr * cov * T;
                T *= (1.0 - min(1.0, rr * rr));
            }
        }
        t += max(cell, R);
    }
    return vec4(rad, T);
}
void main() {
    ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    if (hp.x >= u_half_size.x || hp.y >= u_half_size.y) {
        imageStore(u_gi_half, hp, vec4(0.0));
        return;
    }
    ivec2 px = hp * 2;   // full-res texel this gather represents
    vec3 pos = texelFetch(gbuf_pos, px, 0).xyz;
    float mirror = texelFetch(gbuf_alb, px, 0).a;
    if (dot(pos, pos) < 1e-8 || mirror > 0.5) {
        imageStore(u_gi_half, hp, vec4(0.0));
        return;
    }
    vec3 n = normalize(texelFetch(gbuf_nrm, px, 0).xyz);

    vec3 t1 = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0, 1, 0)) : cross(n, vec3(1, 0, 0)));
    vec3 t2 = cross(n, t1);
    const float tilt = 1.0;
    const float tanh_ = 0.577;   // 30 degree half-angle
    vec3 dirs[5] = vec3[5](n,
                           normalize(n + tilt * t1),
                           normalize(n - tilt * t1),
                           normalize(n + tilt * t2),
                           normalize(n - tilt * t2));
    float wts[5] = float[5](1.0, 0.707, 0.707, 0.707, 0.707);
    vec3 irr = vec3(0.0);
    float ao = 0.0;
    float wsum = 0.0;
    for (int c = 0; c < u_cone_count; ++c) {
        vec4 rt = cone_march(pos + n * 0.02, dirs[c], tanh_, 0.05);
        irr += rt.rgb * wts[c];
        ao += rt.a * wts[c];
        wsum += wts[c];
    }
    irr = irr / max(wsum, 1e-3) * u_gain;
    ao /= max(wsum, 1e-3);
    imageStore(u_gi_half, hp, vec4(irr, ao));
}
