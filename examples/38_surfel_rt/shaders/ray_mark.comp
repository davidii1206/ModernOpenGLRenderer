#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

// Ray stream generation, pass A of the order-preserving compaction: count
// the mirror pixels of each 8x8 tile (= workgroup) into a shared counter.
// Pass B (host-side run_scan over the tile counts) produces each tile's
// exclusive base AND the total ray count (scan_blocks' grand-total write);
// pass C (ray_scatter.comp) scatters the rays at tile_base + within-tile
// index. The stream stays in RASTER ORDER, so a warp's rays come from
// adjacent pixels: for smooth mirrors those rays are near-parallel and
// visit the same grid cells (coalesced probes, L1/L2 reuse). The old
// single-pass atomicAdd compaction shuffled the whole screen's mirror
// pixels arbitrarily, destroying that coherence.
// Every workgroup writes its tile count (zeros included), so the tile
// buffers never need clearing. No early returns: all threads reach both
// barriers (threads outside the image simply never count).
layout(binding = 3) uniform sampler2D gbuf_alb;    // RGBA8 albedo + mirror flag

layout(std430, binding = 20) writeonly buffer TileCount { uint tile_count[]; };

uniform ivec2 u_img_size;

shared uint scnt;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (gl_LocalInvocationIndex == 0u) scnt = 0u;
    barrier();
    if (all(lessThan(px, u_img_size)) && texelFetch(gbuf_alb, px, 0).a > 0.5)
        atomicAdd(scnt, 1u);
    barrier();
    if (gl_LocalInvocationIndex == 0u)
        tile_count[gl_WorkGroupID.x] = scnt;
}
