#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

// Rasterized G-buffer (texture units).
layout(binding = 0) uniform sampler2D gbuf_direct;  // RGBA16F direct shaded color
layout(binding = 1) uniform sampler2D gbuf_pos;     // RGBA16F world position
layout(binding = 2) uniform sampler2D gbuf_nrm;     // RGBA16F world normal
layout(binding = 3) uniform sampler2D gbuf_alb;     // RGBA8 albedo + mirror flag

// Surfel SoA buffers (SSBO).
layout(std430, binding = 0) readonly buffer SurfPos { vec4 surfel_pos[]; }; // xyz + radius.w
layout(std430, binding = 1) readonly buffer SurfNrm { vec4 surfel_nrm[]; }; // xyz normal
layout(std430, binding = 2) readonly buffer SurfAlb { vec4 surfel_alb[]; }; // rgb albedo, w = mirror flag

// Sparse uniform grid (SSBO).
layout(std430, binding = 3) readonly buffer CellStart { uint cell_start[]; };
layout(std430, binding = 4) readonly buffer CellCount { uint cell_count[]; };
layout(std430, binding = 5) readonly buffer PackedIdx { uint packed_idx[]; };

// Per-surfel edge cut planes: kSurfelCuts vec4 per surfel.
// cut.xyz = other-face normal, cut.w = offset (inf => no cut).
// Clip: reject p if dot(p - surfel_pos, cut.xyz) > cut.w.
layout(std430, binding = 6) readonly buffer SurfCut { vec4 surfel_cut[]; };

// Outputs (image units).
layout(binding = 3, rgba16f) writeonly uniform image2D u_color;   // composite result
layout(binding = 4, rgba16f) writeonly uniform image2D u_aux;     // debug bundle

uniform ivec2 u_img_size;
uniform vec3 u_cam_pos;
uniform float u_far;

uniform vec3 u_grid_min;
uniform float u_inv_cell;
uniform ivec3 u_grid_res;
uniform uint u_num_surfels;

uniform vec3 u_light_pos;
uniform vec3 u_light_color;
uniform float u_light_intensity;

uniform int u_max_bounces;
uniform float u_radius_scale;      // multiplies each surfel's stored radius
uniform float u_search_radius;     // max effective radius (grid/traversal bounds)
uniform float u_ambient;
uniform int u_aux_mode;   // 0=albedo 1=normal 2=position 3=depth

struct Hit {
    vec3 pos;
    vec3 nrm;
    vec3 alb;
    float t;
    bool is_mirror;
};

uint cell_index(ivec3 c) {
    return uint(c.x + u_grid_res.x * (c.y + u_grid_res.y * c.z));
}

bool cell_in_bounds(ivec3 c) {
    return c.x >= 0 && c.y >= 0 && c.z >= 0 &&
           c.x < u_grid_res.x && c.y < u_grid_res.y && c.z < u_grid_res.z;
}

float cell_size() { return 1.0 / u_inv_cell; }

// Per-surfel effective disk radius (paper: r slightly bigger than the biggest hole;
// scaling it smooths the surface, see paper Fig. 2). Each surfel carries its own
// adaptive base radius in surfel_pos[s].w (shrinks near edges, paper §7).
float surfel_r(int s) { return surfel_pos[s].w * u_radius_scale; }

// Global search radius = max effective radius, used for grid/traversal bounds so
// every disk is reachable from its cell's neighborhood. Matches surfel_r (scaled).
float search_r() { return u_search_radius * u_radius_scale; }

const int kSurfelCuts = 6;

// Edge-cut clip test for surfel s at point p (on s's tangent plane). Rejects p if
// it lies outside any stored cut plane (i.e. across a sharp edge into the
// neighboring face's half-space). cut.w == inf disables that slot.
bool cut_rejects(int s, vec3 p) {
    vec3 c = surfel_pos[s].xyz;
    int base = s * kSurfelCuts;
    for (int k = 0; k < kSurfelCuts; ++k) {
        vec4 cut = surfel_cut[base + k];
        if (cut.w >= 1e29) continue;
        if (dot(p - c, cut.xyz) > cut.w) return true;
    }
    return false;
}

// Tangent-plane disk test for one surfel (paper §4.1). The disk lies in the
// surfel's tangent plane; a hit is the ray-plane intersection within radius r.
bool surfel_hit(int s, vec3 o, vec3 d, float t_near, float t_far, out float ht) {
    vec3 c = surfel_pos[s].xyz;
    float r = surfel_r(s);
    vec3 n = surfel_nrm[s].xyz;

    float denom = dot(d, n);
    // Single-sided surfel disks (paper §4.1): cull backfaces, i.e. only accept
    // surfels whose normal faces the ray origin (dot(d,n) < 0).
    if (denom >= 1e-6) return false;
    float t = dot(c - o, n) / denom;
    if (t < t_near || t > t_far) return false;

    vec3 p = o + t * d;
    if (length(p - c) > r) return false;
    // Edge-cut: reject hits that fall across a sharp edge into a neighboring face.
    if (cut_rejects(s, p)) return false;
    ht = t;
    return true;
}

// Amanatides & Woo DDA through the sparse uniform grid, clipped to the grid AABB.
// Returns the nearest surfel disk hit; the surface is then reconstructed with the
// paper's interpolation (Eq. 1) over the tangent-plane disk distances.
bool trace_ray(vec3 o, vec3 d, float t_near, float t_far, out Hit hit) {
    float cs = cell_size();
    float r = search_r();
    vec3 bmin = u_grid_min;
    vec3 bmax = u_grid_min + vec3(float(u_grid_res.x), float(u_grid_res.y), float(u_grid_res.z)) * cs;

    // --- Clip ray to grid AABB ---
    float tmin = t_near;
    float tmax = t_far;
    for (int a = 0; a < 3; ++a) {
        float da = d[a];
        float oa = o[a];
        if (abs(da) < 1e-20) {
            if (oa < bmin[a] || oa > bmax[a]) return false;
        } else {
            float t0 = (bmin[a] - oa) / da;
            float t1 = (bmax[a] - oa) / da;
            if (t0 > t1) { float tmp = t0; t0 = t1; t1 = tmp; }
            tmin = max(tmin, t0);
            tmax = min(tmax, t1);
            if (tmin > tmax) return false;
        }
    }
    if (tmax < t_near || tmin > t_far) return false;

    // --- DDA from the grid entry point ---
    vec3 p0 = o + d * tmin;
    ivec3 ic = ivec3(floor((p0 - u_grid_min) * u_inv_cell));
    ic = clamp(ic, ivec3(0), u_grid_res - 1);
    vec3 cell_min = u_grid_min + vec3(ic) * cs;

    vec3 tmaxv;
    tmaxv.x = (d.x > 1e-12) ? (cell_min.x + cs - p0.x) / d.x :
              ((d.x < -1e-12) ? (cell_min.x - p0.x) / d.x : 1e30);
    tmaxv.y = (d.y > 1e-12) ? (cell_min.y + cs - p0.y) / d.y :
              ((d.y < -1e-12) ? (cell_min.y - p0.y) / d.y : 1e30);
    tmaxv.z = (d.z > 1e-12) ? (cell_min.z + cs - p0.z) / d.z :
              ((d.z < -1e-12) ? (cell_min.z - p0.z) / d.z : 1e30);

    vec3 tdelta = cs / (abs(d) + 1e-20);
    ivec3 stepv = ivec3(sign(d));

    float t_cur = tmin;
    bool found = false;
    Hit best;
    best.t = 1e30;

    for (int iter = 0; iter < 512; ++iter) {
        if (!cell_in_bounds(ic)) break;
        if (t_cur > best.t + r) break;
        if (t_cur > tmax) break;

        // The paper surrounds the ray with a cylinder of radius r and visits all
        // cells it intersects. A disk centered in a neighboring cell can be hit
        // even if the ray's centerline never enters that cell; testing only the
        // centerline cell would miss it (gaps at silhouettes/edges). With
        // cell_size = 2*search_r, every intersected disk lies within a 3x3x3
        // neighborhood of the current cell, so test that whole neighborhood.
        for (int ndz = -1; ndz <= 1; ++ndz)
        for (int ndy = -1; ndy <= 1; ++ndy)
        for (int ndx = -1; ndx <= 1; ++ndx) {
            ivec3 nc = ic + ivec3(ndx, ndy, ndz);
            if (!cell_in_bounds(nc)) continue;
            uint nci = cell_index(nc);
            uint start = cell_start[nci];
            uint count = cell_count[nci];
            if (count == 0) continue;
            // A disk centered in this cell can be hit slightly before the ray
            // reaches it (its plane extends up to ~r), so relax the near bound.
            float relax_near = max(tmin, t_cur - r);
            for (uint k = 0; k < count; ++k) {
                int s = int(packed_idx[start + k]);
                float ht;
                if (surfel_hit(s, o, d, relax_near, t_far, ht) && ht < best.t) {
                    best.t = ht;
                    found = true;
                }
            }
        }

        float tn = min(tmaxv.x, min(tmaxv.y, tmaxv.z));
        if (tn >= tmax) break;
        t_cur = tn;
        if (tn == tmaxv.x) { ic.x += stepv.x; tmaxv.x += tdelta.x; }
        else if (tn == tmaxv.y) { ic.y += stepv.y; tmaxv.y += tdelta.y; }
        else { ic.z += stepv.z; tmaxv.z += tdelta.z; }
    }

    if (!found) return false;

    // --- Surface reconstruction (paper §4.2, Eq. 1). Collect surfels whose
    // tangent-plane disk distance d_i is < r (distance measured IN the plane of
    // the point and its normal, NOT orthogonal to the ray). Weight by (r - d_i).
    // The hit position is found by interpolating the ray parameter t of each
    // surfel's plane intersection, placed back on the ray: pos = o + d * t_int.
    vec3 hit_pos = o + d * best.t;
    vec3 acc_nrm = vec3(0.0), acc_alb = vec3(0.0);
    float acc_t = 0.0;
    float wsum = 0.0;
    bool mirror = false;
    Hit nearest;
    nearest.t = 1e30;
    nearest.nrm = vec3(0.0, 1.0, 0.0);
    nearest.alb = vec3(0.8);

    ivec3 hc = ivec3(floor((hit_pos - u_grid_min) * u_inv_cell));
    // 5x5x5 neighborhood covers +/-2 cells = +/-4r, safe for radius_scale up to 2.
    for (int dz = -2; dz <= 2; ++dz)
    for (int dy = -2; dy <= 2; ++dy)
    for (int dx = -2; dx <= 2; ++dx) {
        ivec3 cc = hc + ivec3(dx, dy, dz);
        if (!cell_in_bounds(cc)) continue;
        uint ci = cell_index(cc);
        uint start = cell_start[ci];
        uint count = cell_count[ci];
        for (uint k = 0; k < count; ++k) {
            int s = int(packed_idx[start + k]);
            vec3 c = surfel_pos[s].xyz;
            vec3 n = surfel_nrm[s].xyz;

            // Ray intersection with this surfel's tangent plane.
            float denom = dot(d, n);
            // Cull backfaces: only blend surfels whose normal faces the ray
            // origin (single-sided disks, consistent with surfel_hit).
            if (denom >= 1e-6) continue;
            float t_i = dot(c - o, n) / denom;
            if (t_i < tmin || t_i > t_far) continue;
            // Parallax gate: only blend surfels whose own disk lies within the
            // search radius of the winning hit in ray parameter. Surfels on a
            // different (adjacent, edge-on) face intersect the ray far from
            // best.t and would otherwise round/blur the silhouette (edge bleed).
            if (abs(t_i - best.t) > r) continue;
            vec3 q = o + d * t_i;
            float d_i = length(q - c);          // tangent-plane disk distance
            float sr = surfel_r(s);             // adaptive per-surfel radius
            if (d_i >= sr) continue;
            // Edge-cut: don't blend this surfel's contribution across a sharp edge.
            if (cut_rejects(s, q)) continue;

            float w = sr - d_i;
            acc_t += t_i * w;
            acc_nrm += n * w;
            acc_alb += surfel_alb[s].rgb * w;
            wsum += w;
            mirror = mirror || surfel_alb[s].w > 0.5;

            if (t_i < nearest.t) {
                nearest.t = t_i;
                nearest.nrm = n;
                nearest.alb = surfel_alb[s].rgb;
            }
        }
    }

    if (wsum > 1e-8) {
        hit.pos = o + d * (acc_t / wsum);
        hit.nrm = normalize(acc_nrm / wsum);
        hit.alb = acc_alb / wsum;
    } else {
        hit.pos = hit_pos;
        hit.nrm = nearest.nrm;
        hit.alb = nearest.alb;
    }
    hit.t = best.t;
    hit.is_mirror = mirror;

    // Flip normal toward the ray origin (paper §5).
    if (dot(hit.nrm, d) > 0.0) hit.nrm = -hit.nrm;
    return true;
}

vec3 shade(vec3 alb, vec3 n, vec3 pos) {
    vec3 to_light = u_light_pos - pos;
    float dist2 = dot(to_light, to_light);
    float dist = sqrt(dist2);
    vec3 L = to_light / max(dist, 1e-5);
    float ndl = max(dot(n, L), 0.0);
    return alb * (u_light_color * u_light_intensity) * ndl / max(dist2, 1e-4)
         + alb * u_ambient;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= u_img_size.x || px.y >= u_img_size.y) return;

    vec4 gpos4 = texelFetch(gbuf_pos, px, 0);
    vec3 gpos = gpos4.xyz;
    if (dot(gpos, gpos) < 1e-8) {
        imageStore(u_color, px, vec4(0.0));
        imageStore(u_aux, px, vec4(0.0));
        return;
    }

    vec3 gnrm = normalize(texelFetch(gbuf_nrm, px, 0).xyz);
    vec4 galb4 = texelFetch(gbuf_alb, px, 0);
    vec3 galb = galb4.rgb;
    float gmirror = galb4.a;
    vec3 gdirect = texelFetch(gbuf_direct, px, 0).rgb;

    // Debug aux from the primary (rasterized) surface.
    vec3 aux = galb;
    if (u_aux_mode == 1) aux = gnrm * 0.5 + 0.5;
    else if (u_aux_mode == 2) aux = gpos * 0.5 + 0.5;
    else if (u_aux_mode == 3) aux = vec3(length(gpos - u_cam_pos) / u_far);
    imageStore(u_aux, px, vec4(aux, 1.0));

    // Ensure the normal faces the camera (double-sided box faces).
    vec3 view_dir = normalize(gpos - u_cam_pos);
    if (dot(gnrm, view_dir) > 0.0) gnrm = -gnrm;

    vec3 color;
    if (gmirror > 0.5) {
        // Reflected surface: cast a reflection ray through the point-sampled
        // geometry (Schaufler & Jensen), shade what it hits, recurse on mirrors.
        // Paper §5: only accept intersections at least 2r from the ray origin to
        // avoid false hits on the mirror's own surfels. Instead of rejecting all
        // hits within 2r (which also deletes genuinely close geometry, e.g.
        // surfaces meeting at contact edges -> gaps), pad the ray ORIGIN by 2r
        // along the normal (paper's shadow-offset trick): self-surfels then lie
        // behind the origin while real neighbors stay visible.
        color = vec3(0.0);
        float self_off = 2.0 * search_r();
        vec3 ro = gpos + gnrm * self_off;
        vec3 rd = reflect(view_dir, gnrm);
        float t_near = 1e-3;
        for (int b = 0; b < u_max_bounces; ++b) {
            Hit hit;
            if (!trace_ray(ro, rd, t_near, u_far, hit)) break;
            color += shade(hit.alb, hit.nrm, hit.pos);
            if (hit.is_mirror) {
                rd = reflect(rd, hit.nrm);
                ro = hit.pos + hit.nrm * self_off;
            } else {
                break;
            }
        }
    } else {
        // Direct surface: use the rasterized shading (no ray tracing needed).
        color = gdirect;
    }

    imageStore(u_color, px, vec4(color, 1.0));
}