#version 460 core
#extension GL_ARB_shader_clock : enable
layout(local_size_x = 128) in;

// Mirror-ray traversal kernel (one dispatch per bounce of ray_mark.comp's
// stream): one thread per ray, DDA + disk tests only, writing the best-hit
// ray parameter per ray. Surface reconstruction + shading live in
// ray_gather.comp (smaller kernels -> lower register pressure -> higher
// occupancy for the latency-bound traversal). Surviving mirror hits are
// appended to the next bounce's stream by the gather kernel, which also
// accumulates shading into the RGBA32F image display.frag composites.

// Multi-LOD sparse grids: combined per-level arrays, segmented by offsets.
// Level 0 is the coarsest (spans the scene); finer levels cover only the bbox
// of their smaller-radius surfels. A surfel lives in exactly one level.
// cell_sc interleaves start+count per cell (one 8B probe instead of two 4B).
layout(std430, binding = 3) readonly buffer CellSC { uvec2 cell_sc[]; };
layout(std430, binding = 5) readonly buffer PackedIdx { uint packed_idx[]; };

// Per-surfel edge cut planes (anchor form): kSurfelCuts * 2 vec4 per surfel,
// [n.xyz, 0] + [anchor.xyz, 0]. Reject p if dot(p - anchor, n) > 0. Empty
// slots have n = 0 (dot == 0, never rejects). Planes pass exactly through the
// mesh feature edges; layout is ready for per-frame skinned cuts.
layout(std430, binding = 6) readonly buffer SurfCut { vec4 surfel_cut[]; };

// Optional per-dispatch diagnostics (frame-timing / shader-clock counters,
// see the "Ray kernel counters" section of the ImGui window). Every counter is
// gated by the u_perf uniform so the common path is unchanged when off.
// Counters accumulate in SHARED memory and flush once per workgroup: the hot
// loops add ~3k increments per ray, and global same-address atomics at that
// rate serialize the whole GPU; shared atomics are near-free by comparison.
layout(std430, binding = 7) buffer PerfBuf { uint perf[]; };
// perf[]:
//   0 = rays (trace_ray invocations, all bounces)
//   1 = level-0 DDA iterations
//   2 = finer-level descend iterations
//   3 = neighborhood cells scanned (windows / slabs)
//   4 = surfel disk tests (plane intersections)
//   5 = gather surfels tested (surface reconstruction)
//   6 = cycles: setup (per ray)
//   7 = cycles: traversal (DDA + descend + disk tests)
//   8 = cycles: reconstruction (gather + blend)
//   9 = cycles: shade (+ bounce loop)
uniform int u_perf;   // 0 = counters off

// Cell-sorted surfel data, written by grid_compact in the SAME order (and with
// the same per-level offsets) as packed_idx: cell scans become strictly
// sequential reads instead of packed_idx -> surfel_pos[s] gathers. pos+nrm are
// interleaved (2i = pos, 2i+1 = nrm) so a disk test reads one contiguous 32B
// record.
layout(std430, binding = 8) readonly buffer PackedPN { vec4 packed_pn[]; };   // 2i pos xyz+r, 2i+1 nrm
layout(std430, binding = 9) readonly buffer PackedAlb { vec4 packed_alb[]; }; // rgb, w = mirror

// Occupancy bitmask, one bit per cell (built by grid_count): a single load
// skips empty cells in the 27-cell windows and the 5x5x5 gather.
layout(std430, binding = 11) readonly buffer CellMask { uint cell_mask[]; };

// Mega-surfel hierarchy (u_mega): the per-cell COMBINED RENDER LIST as
// contiguous SoA — merged mega records first, then leftover fine surfels
// (border rows) — materialized by mega_renderlist.comp. Same direct-load
// structure as the fine lists (cut reference inline, 0xFFFFFFFF = none),
// just fewer entries where surfels merged.
layout(std430, binding = 16) readonly buffer RdrPN { vec4 rdr_pn[]; };   // 2i pos+r, 2i+1 nrm
layout(std430, binding = 17) readonly buffer RdrAlb { vec4 rdr_alb[]; }; // (unused by traversal)
layout(std430, binding = 18) readonly buffer CombSC { uvec2 comb_sc[]; };
layout(std430, binding = 21) readonly buffer RdrCut { uint rdr_cut[]; };
uniform int u_mega;       // 0 = fine lists, 1 = combined render lists
uniform int u_pair;       // 0 = one ray per thread, 1 = two interleaved rays per thread

// Ray streams (2 vec4 per ray: [px_packed, ro.xyz], [rd.xyz, 0]). Bounce k
// reads its stream (written by the mark kernel for k=0, by the previous trace
// dispatch otherwise) and appends surviving mirror hits to the next one.
layout(std430, binding = 12) readonly buffer StreamIn { vec4 stream_in[]; };
layout(std430, binding = 13) buffer RayCounts { uint counts[]; };   // [bounce]
layout(std430, binding = 14) writeonly buffer StreamOut { vec4 stream_out[]; };

// Per-ray best-hit ray parameter for ray_gather.comp (indexed by ray id in
// this dispatch; -1 = miss).
layout(std430, binding = 15) writeonly buffer HitBuf { float hit_buf[]; };

// Outputs (image unit).
uniform float u_far;

// Per-level grid parameters.
#define kLevels 4
uniform vec3  u_l_min[kLevels];
uniform float u_l_inv_cell[kLevels];
uniform ivec3 u_l_res[kLevels];
uniform uint  u_l_cnt_off[kLevels];
uniform uint  u_l_start_off[kLevels];
uniform uint  u_l_packed_off[kLevels];
uniform uint  u_l_mask_off[kLevels];
uniform uint  u_l_num[kLevels];
uniform float u_l_max_r[kLevels];   // max stored surfel radius in this level
uniform int   u_levels;


uniform int u_max_bounces;
uniform int u_bounce;              // which bounce this dispatch processes
uniform float u_radius_scale;      // multiplies each surfel's stored radius
uniform float u_search_radius;     // max effective radius (traversal bounds)

shared uint lperf[10];
#define PERF_ADD(i, v) if (u_perf != 0) atomicAdd(lperf[i], uint(v))
#define PERF_CYC(i, t0) if (u_perf != 0) atomicAdd(lperf[i], clock2x32ARB().x - t0)

uint l_cell_index(int l, ivec3 c) {
    return uint(c.x + u_l_res[l].x * (c.y + u_l_res[l].y * c.z));
}

bool l_in_bounds(int l, ivec3 c) {
    return c.x >= 0 && c.y >= 0 && c.z >= 0 &&
           c.x < u_l_res[l].x && c.y < u_l_res[l].y && c.z < u_l_res[l].z;
}

// Global search radius = max effective radius, used for traversal bounds.
float search_r(float r_mul) { return u_search_radius * u_radius_scale * r_mul; }

const int kSurfelCuts = 6;

// Edge-cut clip test for surfel s at point p (on s's tangent plane): reject p
// if it lies on the far side of any stored cut plane (across a sharp edge into
// the neighboring face's half-space). Anchor form: plane through anchor with
// normal n; empty slots have n == 0 and never reject.
bool cut_rejects(int s, vec3 p) {
    int base = s * kSurfelCuts * 2;
    for (int k = 0; k < kSurfelCuts; ++k) {
        vec3 n = surfel_cut[base + 2 * k].xyz;
        vec3 a = surfel_cut[base + 2 * k + 1].xyz;
        if (dot(p - a, n) > 0.0) return true;
    }
    return false;
}

// Ray/tangent-plane intersection for one surfel disk (paper §4.1). Single-sided
// (backface cull: only accept surfels whose normal faces the ray origin);
// radius + edge-cut tests are separate so the caller can order them.
bool plane_hit(vec3 c, vec3 n, vec3 o, vec3 d, float t_near, float t_far, out float ht) {
    float denom = dot(d, n);
    if (denom >= 1e-6) return false;
    float t = dot(c - o, n) / denom;
    if (t < t_near || t > t_far) return false;
    ht = t;
    return true;
}

bool cell_occupied(int l, uint ci) {
    return (cell_mask[u_l_mask_off[l] + (ci >> 5)] >> (ci & 31u)) != 0u;
}

// Test one fine candidate (packed index): plane, radius, then edge cut. The
// original surfel index is only needed for the cut planes, so the packed_idx
// indirection load happens only for candidates that pass the radius.
void scan_fine_pi(uint pi, vec3 o, vec3 d, float t_near, float t_far, float r_mul,
                  inout float best_t, inout bool found) {
    vec4 pc = packed_pn[2u * pi];
    PERF_ADD(4, 1);
    float ht;
    if (!plane_hit(pc.xyz, packed_pn[2u * pi + 1u].xyz, o, d, t_near, t_far, ht)) return;
    if (ht >= best_t) return;
    float r = pc.w * u_radius_scale * r_mul;
    vec3 p = o + ht * d;
    if (dot(p - pc.xyz, p - pc.xyz) > r * r) return;
    if (cut_rejects(int(packed_idx[pi]), p)) return;
    best_t = ht;
    found = true;
}

// Scan one cell's surfels (cell-sorted contiguous data). The window callers
// pass t_far already min-clamped against the current best hit, so disks that
// cannot win are rejected by the cheap plane test; the ht >= best_t check
// covers further improvements while the cell is being scanned.
// u_mega: merged representatives first (no cut planes — clusters never span
// edges), then the cell's leftover fine surfels (border rows, exact cuts).
void scan_cell(int l, ivec3 nc, vec3 o, vec3 d, float t_near, float t_far, float r_mul,
               inout float best_t, inout bool found) {
    if (!l_in_bounds(l, nc)) return;
    uint nci = l_cell_index(l, nc);
    if (!cell_occupied(l, nci)) return;
    PERF_ADD(3, 1);
    if (u_mega != 0) {
        uvec2 cs = comb_sc[u_l_cnt_off[l] + nci];
        uint base = u_l_packed_off[l] + cs.x;
        for (uint k = 0; k < cs.y; ++k) {
            uint di = base + k;
            vec4 pc = rdr_pn[2u * di];
            PERF_ADD(4, 1);
            float ht;
            if (!plane_hit(pc.xyz, rdr_pn[2u * di + 1u].xyz, o, d, t_near, t_far, ht)) continue;
            if (ht >= best_t) continue;
            float r = pc.w * u_radius_scale * r_mul;
            vec3 p = o + ht * d;
            if (dot(p - pc.xyz, p - pc.xyz) > r * r) continue;
            // Cut reference inline: merged records carry none (clusters never
            // span edges), leftover fine surfels keep their exact cuts.
            uint cr = rdr_cut[di];
            if (cr != 0xFFFFFFFFu && cut_rejects(int(cr), p)) continue;
            best_t = ht;
            found = true;
        }
        return;
    }
    uvec2 sc = cell_sc[u_l_cnt_off[l] + nci];
    uint pbase = u_l_packed_off[l] + sc.x;
    for (uint k = 0; k < sc.y; ++k)
        scan_fine_pi(pbase + k, o, d, t_near, t_far, r_mul, best_t, found);
}

// Full 3x3x3 neighborhood hit scan at level l around cell ic (entry windows).
void scan_neighborhood(int l, ivec3 ic, vec3 o, vec3 d, float t_far, float relax_near,
                       float r_mul, inout float best_t, inout bool found) {
    float tf = found ? min(t_far, best_t) : t_far;
    for (int nz = -1; nz <= 1; ++nz)
    for (int ny = -1; ny <= 1; ++ny)
    for (int nx = -1; nx <= 1; ++nx)
        scan_cell(l, ic + ivec3(nx, ny, nz), o, d, relax_near, tf, r_mul, best_t, found);
}

// Incremental window scan after a DDA step along axis a: of the new cell's
// 3x3x3 window, 18 cells were already covered by the previous window, so only
// the 9-cell slab perpendicular to the step axis is new. Scanning exactly the
// new slab keeps the union of scanned windows identical to the old full-scan
// scheme while eliminating ~2/3 of all cell visits and duplicate disk tests.
void scan_slab(int l, ivec3 ic, int a, vec3 o, vec3 d, float t_far, float relax_near,
               float r_mul, inout float best_t, inout bool found) {
    float tf = found ? min(t_far, best_t) : t_far;
    for (int j = -1; j <= 1; ++j)
    for (int k = -1; k <= 1; ++k) {
        ivec3 off = ivec3(0);
        if (a == 0) { off.y = j; off.z = k; }
        else if (a == 1) { off.x = j; off.z = k; }
        else { off.x = j; off.y = k; }
        scan_cell(l, ic + off, o, d, relax_near, tf, r_mul, best_t, found);
    }
}

// DDA through finer level l's grid, clipped to [t_in, t_out] (the coarse cell's
// t-interval), [ta_in, ta_out] (the ray/level-AABB interval, precomputed once
// per ray — exact: max/min fold associatively), and padded by the search
// radius so disks centered inside the cell but crossing slightly outside it
// (tilted planes) are still visited. Bounded iterations; early-outs once the
// ray is beyond the best hit. Full window at the entry cell, incremental slabs
// afterwards (see scan_slab).
void descend(int l, vec3 o, vec3 d, float t_in, float t_out, float t_far, float r_mul,
             float ta_in, float ta_out, inout float best_t, inout bool found) {
    if (u_l_num[l] == 0u) return;
    float cs = 1.0 / u_l_inv_cell[l];
    float pad = search_r(r_mul);
    float tmin = max(max(t_in - pad, ta_in), 0.0);
    float tmax = min(min(t_out + pad, t_far), ta_out);
    if (tmin > tmax) return;
    if (found && tmin > best_t + pad) return;
    vec3 bmin = u_l_min[l];

    vec3 p0 = o + d * tmin;
    ivec3 ic = clamp(ivec3(floor((p0 - bmin) * u_l_inv_cell[l])), ivec3(0), u_l_res[l] - 1);
    vec3 cell_min = bmin + vec3(ic) * cs;
    vec3 tmaxv;
    tmaxv.x = (d.x > 1e-12) ? (cell_min.x + cs - p0.x) / d.x :
              ((d.x < -1e-12) ? (cell_min.x - p0.x) / d.x : 1e30);
    tmaxv.y = (d.y > 1e-12) ? (cell_min.y + cs - p0.y) / d.y :
              ((d.y < -1e-12) ? (cell_min.y - p0.y) / d.y : 1e30);
    tmaxv.z = (d.z > 1e-12) ? (cell_min.z + cs - p0.z) / d.z :
              ((d.z < -1e-12) ? (cell_min.z - p0.z) / d.z : 1e30);
    vec3 tdelta = cs / (abs(d) + 1e-20);
    ivec3 stepv = ivec3(sign(d));

    float t_cur = tmin;
    {
        PERF_ADD(2, 1);
        float relax_near = max(tmin, t_cur - pad);
        scan_neighborhood(l, ic, o, d, t_far, relax_near, r_mul, best_t, found);
    }
    for (int iter = 0; iter < 256; ++iter) {
        if (t_cur > tmax) break;
        if (found && t_cur > best_t + pad) break;
        float tn = min(tmaxv.x, min(tmaxv.y, tmaxv.z));
        if (tn >= tmax) break;
        t_cur = tn;
        int axis;
        if (tn == tmaxv.x) { ic.x += stepv.x; tmaxv.x += tdelta.x; axis = 0; }
        else if (tn == tmaxv.y) { ic.y += stepv.y; tmaxv.y += tdelta.y; axis = 1; }
        else { ic.z += stepv.z; tmaxv.z += tdelta.z; axis = 2; }
        if (!l_in_bounds(l, ic)) break;
        if (found && t_cur > best_t + pad) break;
        PERF_ADD(2, 1);
        float relax_near = max(tmin, t_cur - pad);
        scan_slab(l, ic, axis, o, d, t_far, relax_near, r_mul, best_t, found);
    }
}


// ---------------------------------------------------------------------------
// Pair-traversal (u_pair): one thread advances TWO independent ray state
// machines in lockstep. The grid caps warp residency at ~36% (rays / warp
// slots) and resident warps stall on dependent grid loads (Nsight: CS warp
// occupancy ~10%, SM issue ~12%, memory units <30%) — interleaving a second
// ray's loads gives the scheduler independent work to hide the latency
// without needing more warps. Per-ray traversal logic is IDENTICAL to
// trace_best/descend above: same scan order, same gates, same early-outs —
// only the scheduling changes.
// ---------------------------------------------------------------------------

struct DdaX {
    vec3 o, d;
    float t_cur, tmax;
    ivec3 ic;
    vec3 tmaxv;
    ivec3 stepv;
    vec3 tdelta;
    float best_t;
    bool found;
    bool act;
};

// One fine DDA step for ray r. `alive` is the CALLER-LOCAL liveness flag of
// this descend (deliberately separate from the DdaX.act L0-march flag).
void dda_step(inout DdaX r, int l, float t_far, float relax_base, float r_mul,
              inout bool alive) {
    if (r.t_cur > r.tmax) { alive = false; return; }
    if (r.found && r.t_cur > r.best_t + search_r(r_mul)) { alive = false; return; }
    float tn = min(r.tmaxv.x, min(r.tmaxv.y, r.tmaxv.z));
    if (tn >= r.tmax) { alive = false; return; }
    r.t_cur = tn;
    int axis;
    if (tn == r.tmaxv.x) { r.ic.x += r.stepv.x; r.tmaxv.x += r.tdelta.x; axis = 0; }
    else if (tn == r.tmaxv.y) { r.ic.y += r.stepv.y; r.tmaxv.y += r.tdelta.y; axis = 1; }
    else { r.ic.z += r.stepv.z; r.tmaxv.z += r.tdelta.z; axis = 2; }
    if (!l_in_bounds(l, r.ic)) { alive = false; return; }
    // Newly entered cell is already beyond the best hit: skip its scan.
    if (r.found && r.t_cur > r.best_t + search_r(r_mul)) { alive = false; return; }
    PERF_ADD(2, 1);
    float relax_near = max(relax_base, r.t_cur - search_r(r_mul));
    float tf = r.found ? min(t_far, r.best_t) : t_far;
    scan_slab(l, r.ic, axis, r.o, r.d, tf, relax_near, r_mul, r.best_t, r.found);
}

// Fused dual descend at level l: two fine DDAs, alternating single steps in
// one loop so their scan_slab load chains overlap.
void descend2(int l, float t_far, float r_mul,
              inout DdaX a, float t_inA, float t_outA, float ta_inA, float ta_outA,
              inout DdaX b, float t_inB, float t_outB, float ta_inB, float ta_outB) {
    if (u_l_num[l] == 0u) return;
    float cs = 1.0 / u_l_inv_cell[l];
    float pad = search_r(r_mul);
    vec3 bmin = u_l_min[l];

    float tminA = max(max(t_inA - pad, ta_inA), 0.0);
    float tmaxA = min(min(t_outA + pad, t_far), ta_outA);
    float tminB = max(max(t_inB - pad, ta_inB), 0.0);
    float tmaxB = min(min(t_outB + pad, t_far), ta_outB);
    bool actA = tminA <= tmaxA && !(a.found && tminA > a.best_t + pad);
    bool actB = tminB <= tmaxB && !(b.found && tminB > b.best_t + pad);
    if (!actA && !actB) return;

    // LOCAL fine-DDA state: the structs' t_cur/tmax/ic/tmaxv fields belong to
    // the L0 march and must not be clobbered by the descend.
    DdaX sa = a, sb = b;

    if (actA) {
        sa.t_cur = tminA; sa.tmax = tmaxA;
        vec3 p0 = sa.o + sa.d * tminA;
        sa.ic = clamp(ivec3(floor((p0 - bmin) * u_l_inv_cell[l])), ivec3(0), u_l_res[l] - 1);
        vec3 cell_min = bmin + vec3(sa.ic) * cs;
        sa.tmaxv.x = (sa.d.x > 1e-12) ? (cell_min.x + cs - p0.x) / sa.d.x : ((sa.d.x < -1e-12) ? (cell_min.x - p0.x) / sa.d.x : 1e30);
        sa.tmaxv.y = (sa.d.y > 1e-12) ? (cell_min.y + cs - p0.y) / sa.d.y : ((sa.d.y < -1e-12) ? (cell_min.y - p0.y) / sa.d.y : 1e30);
        sa.tmaxv.z = (sa.d.z > 1e-12) ? (cell_min.z + cs - p0.z) / sa.d.z : ((sa.d.z < -1e-12) ? (cell_min.z - p0.z) / sa.d.z : 1e30);
        sa.tdelta = cs / (abs(sa.d) + 1e-20);
        sa.stepv = ivec3(sign(sa.d));
        PERF_ADD(2, 1);
        scan_neighborhood(l, sa.ic, sa.o, sa.d, t_far, max(tminA, sa.t_cur - pad), r_mul, sa.best_t, sa.found);
    }
    if (actB) {
        sb.t_cur = tminB; sb.tmax = tmaxB;
        vec3 p0 = sb.o + sb.d * tminB;
        sb.ic = clamp(ivec3(floor((p0 - bmin) * u_l_inv_cell[l])), ivec3(0), u_l_res[l] - 1);
        vec3 cell_min = bmin + vec3(sb.ic) * cs;
        sb.tmaxv.x = (sb.d.x > 1e-12) ? (cell_min.x + cs - p0.x) / sb.d.x : ((sb.d.x < -1e-12) ? (cell_min.x - p0.x) / sb.d.x : 1e30);
        sb.tmaxv.y = (sb.d.y > 1e-12) ? (cell_min.y + cs - p0.y) / sb.d.y : ((sb.d.y < -1e-12) ? (cell_min.y - p0.y) / sb.d.y : 1e30);
        sb.tmaxv.z = (sb.d.z > 1e-12) ? (cell_min.z + cs - p0.z) / sb.d.z : ((sb.d.z < -1e-12) ? (cell_min.z - p0.z) / sb.d.z : 1e30);
        sb.tdelta = cs / (abs(sb.d) + 1e-20);
        sb.stepv = ivec3(sign(sb.d));
        PERF_ADD(2, 1);
        scan_neighborhood(l, sb.ic, sb.o, sb.d, t_far, max(tminB, sb.t_cur - pad), r_mul, sb.best_t, sb.found);
    }
    for (int iter = 0; iter < 256 && (actA || actB); ++iter) {
        if (actA) dda_step(sa, l, t_far, tminA, r_mul, actA);
        if (actB) dda_step(sb, l, t_far, tminB, r_mul, actB);
    }
    a.best_t = sa.best_t; a.found = sa.found;
    b.best_t = sb.best_t; b.found = sb.found;
}

// Fused pair traversal of the coarsest grid. Outputs best-hit ray parameters
// (-1 on miss) for both rays. Ray B is optional (actB=false skips it).
void trace_best2(inout DdaX a, inout DdaX b, float t_near, float t_far, float r_mul) {
    uint trav0 = 0;
    if (u_perf != 0) trav0 = clock2x32ARB().x;
    float cs0 = 1.0 / u_l_inv_cell[0];
    float pad = search_r(r_mul);
    vec3 bmin = u_l_min[0];
    vec3 bmax = u_l_min[0] + vec3(u_l_res[0]) * cs0;

    float tminA = t_near, tmaxA = t_far;
    if (a.act) {
        for (int ax = 0; ax < 3; ++ax) {
            float da = a.d[ax], oa = a.o[ax];
            if (abs(da) < 1e-20) {
                if (oa < bmin[ax] || oa > bmax[ax]) { a.act = false; break; }
            } else {
                float t0 = (bmin[ax] - oa) / da;
                float t1 = (bmax[ax] - oa) / da;
                if (t0 > t1) { float tmp = t0; t0 = t1; t1 = tmp; }
                tminA = max(tminA, t0);
                tmaxA = min(tmaxA, t1);
                if (tminA > tmaxA) { a.act = false; break; }
            }
        }
        if (a.act && (tmaxA < t_near || tminA > t_far)) a.act = false;
    }
    float tminB = t_near, tmaxB = t_far;
    if (b.act) {
        for (int ax = 0; ax < 3; ++ax) {
            float da = b.d[ax], oa = b.o[ax];
            if (abs(da) < 1e-20) {
                if (oa < bmin[ax] || oa > bmax[ax]) { b.act = false; break; }
            } else {
                float t0 = (bmin[ax] - oa) / da;
                float t1 = (bmax[ax] - oa) / da;
                if (t0 > t1) { float tmp = t0; t0 = t1; t1 = tmp; }
                tminB = max(tminB, t0);
                tmaxB = min(tmaxB, t1);
                if (tminB > tmaxB) { b.act = false; break; }
            }
        }
        if (b.act && (tmaxB < t_near || tminB > t_far)) b.act = false;
    }
    if (!a.act && !b.act) {
        if (u_perf != 0) { PERF_CYC(7, trav0); }
        return;
    }

    // Entry cells + boundary state.
    if (a.act) {
        vec3 p0 = a.o + a.d * tminA;
        a.ic = clamp(ivec3(floor((p0 - bmin) * u_l_inv_cell[0])), ivec3(0), u_l_res[0] - 1);
        vec3 cell_min = bmin + vec3(a.ic) * cs0;
        a.tmaxv.x = (a.d.x > 1e-12) ? (cell_min.x + cs0 - p0.x) / a.d.x : ((a.d.x < -1e-12) ? (cell_min.x - p0.x) / a.d.x : 1e30);
        a.tmaxv.y = (a.d.y > 1e-12) ? (cell_min.y + cs0 - p0.y) / a.d.y : ((a.d.y < -1e-12) ? (cell_min.y - p0.y) / a.d.y : 1e30);
        a.tmaxv.z = (a.d.z > 1e-12) ? (cell_min.z + cs0 - p0.z) / a.d.z : ((a.d.z < -1e-12) ? (cell_min.z - p0.z) / a.d.z : 1e30);
        a.tdelta = cs0 / (abs(a.d) + 1e-20);
        a.stepv = ivec3(sign(a.d));
        a.t_cur = tminA; a.tmax = tmaxA;
        PERF_ADD(1, 1);
        scan_neighborhood(0, a.ic, a.o, a.d, t_far, max(tminA, a.t_cur - pad), r_mul, a.best_t, a.found);
    }
    if (b.act) {
        vec3 p0 = b.o + b.d * tminB;
        b.ic = clamp(ivec3(floor((p0 - bmin) * u_l_inv_cell[0])), ivec3(0), u_l_res[0] - 1);
        vec3 cell_min = bmin + vec3(b.ic) * cs0;
        b.tmaxv.x = (b.d.x > 1e-12) ? (cell_min.x + cs0 - p0.x) / b.d.x : ((b.d.x < -1e-12) ? (cell_min.x - p0.x) / b.d.x : 1e30);
        b.tmaxv.y = (b.d.y > 1e-12) ? (cell_min.y + cs0 - p0.y) / b.d.y : ((b.d.y < -1e-12) ? (cell_min.y - p0.y) / b.d.y : 1e30);
        b.tmaxv.z = (b.d.z > 1e-12) ? (cell_min.z + cs0 - p0.z) / b.d.z : ((b.d.z < -1e-12) ? (cell_min.z - p0.z) / b.d.z : 1e30);
        b.tdelta = cs0 / (abs(b.d) + 1e-20);
        b.stepv = ivec3(sign(b.d));
        b.t_cur = tminB; b.tmax = tmaxB;
        PERF_ADD(1, 1);
        scan_neighborhood(0, b.ic, b.o, b.d, t_far, max(tminB, b.t_cur - pad), r_mul, b.best_t, b.found);
    }
    // Entry descents for both rays (level by level, both rays together).
    for (int l = 1; l < u_levels; ++l) {
        float eA = min(min(a.tmaxv.x, a.tmaxv.y), min(a.tmaxv.z, a.tmax));
        float eB = min(min(b.tmaxv.x, b.tmaxv.y), min(b.tmaxv.z, b.tmax));
        descend2(l, t_far, r_mul,
                 a, a.t_cur, eA, a.act ? -1e30 : 1e30, 1e30,
                 b, b.t_cur, eB, b.act ? -1e30 : 1e30, 1e30);
        if (!a.act && !b.act) break;
    }
    // Fused coarse march: advance each ray one slab per iteration, descents
    // via descend2 with the slab's t-interval.
    float ta_inA[kLevels], ta_outA[kLevels];
    float ta_inB[kLevels], ta_outB[kLevels];
    for (int l = 1; l < u_levels; ++l) {
        ta_inA[l] = -1e30; ta_outA[l] = 1e30;
        ta_inB[l] = -1e30; ta_outB[l] = 1e30;
        if (u_l_num[l] == 0u) continue;
        float lcs = 1.0 / u_l_inv_cell[l];
        vec3 lbmax = u_l_min[l] + vec3(u_l_res[l]) * lcs;
        {
            bool miss = false;
            for (int ax = 0; ax < 3; ++ax) {
                float da = a.d[ax], oa = a.o[ax];
                if (abs(da) < 1e-20) { if (a.o[ax] < u_l_min[l][ax] || a.o[ax] > lbmax[ax]) miss = true; }
                else {
                    float t0 = (u_l_min[l][ax] - a.o[ax]) / da;
                    float t1 = (lbmax[ax] - a.o[ax]) / da;
                    if (t0 > t1) { float tmp = t0; t0 = t1; t1 = tmp; }
                    ta_inA[l] = max(ta_inA[l], t0);
                    ta_outA[l] = min(ta_outA[l], t1);
                }
            }
            if (miss) ta_inA[l] = 1e30;
        }
        {
            bool miss = false;
            for (int ax = 0; ax < 3; ++ax) {
                float da = b.d[ax], oa = b.o[ax];
                if (abs(da) < 1e-20) { if (b.o[ax] < u_l_min[l][ax] || b.o[ax] > lbmax[ax]) miss = true; }
                else {
                    float t0 = (u_l_min[l][ax] - b.o[ax]) / da;
                    float t1 = (lbmax[ax] - b.o[ax]) / da;
                    if (t0 > t1) { float tmp = t0; t0 = t1; t1 = tmp; }
                    ta_inB[l] = max(ta_inB[l], t0);
                    ta_outB[l] = min(ta_outB[l], t1);
                }
            }
            if (miss) ta_inB[l] = 1e30;
        }
    }
    for (int iter = 0; iter < 512 && (a.act || b.act); ++iter) {
        // Each ray: advance one slab (or deactivate); remember its slab
        // t-interval for the descents below.
        float slab_inA = 0.0, slab_outA = 0.0, slab_inB = 0.0, slab_outB = 0.0;
        bool didA = false, didB = false;
        if (a.act && a.t_cur <= a.tmax && !(a.found && a.t_cur > a.best_t + pad)) {
            float tn = min(a.tmaxv.x, min(a.tmaxv.y, a.tmaxv.z));
            if (tn < a.tmax) {
                a.t_cur = tn;
                int axis;
                if (tn == a.tmaxv.x) { a.ic.x += a.stepv.x; a.tmaxv.x += a.tdelta.x; axis = 0; }
                else if (tn == a.tmaxv.y) { a.ic.y += a.stepv.y; a.tmaxv.y += a.tdelta.y; axis = 1; }
                else { a.ic.z += a.stepv.z; a.tmaxv.z += a.tdelta.z; axis = 2; }
                if (l_in_bounds(0, a.ic) && !(a.found && a.t_cur > a.best_t + pad)) {
                    PERF_ADD(1, 1);
                    scan_slab(0, a.ic, axis, a.o, a.d, t_far, max(tminA, a.t_cur - pad), r_mul, a.best_t, a.found);
                    slab_inA = a.t_cur;
                    slab_outA = min(min(a.tmaxv.x, a.tmaxv.y), min(a.tmaxv.z, a.tmax));
                    didA = true;
                } else a.act = false;
            } else a.act = false;
        } else if (a.act) a.act = false;
        if (b.act && b.t_cur <= b.tmax && !(b.found && b.t_cur > b.best_t + pad)) {
            float tn = min(b.tmaxv.x, min(b.tmaxv.y, b.tmaxv.z));
            if (tn < b.tmax) {
                b.t_cur = tn;
                int axis;
                if (tn == b.tmaxv.x) { b.ic.x += b.stepv.x; b.tmaxv.x += b.tdelta.x; axis = 0; }
                else if (tn == b.tmaxv.y) { b.ic.y += b.stepv.y; b.tmaxv.y += b.tdelta.y; axis = 1; }
                else { b.ic.z += b.stepv.z; b.tmaxv.z += b.tdelta.z; axis = 2; }
                if (l_in_bounds(0, b.ic) && !(b.found && b.t_cur > b.best_t + pad)) {
                    PERF_ADD(1, 1);
                    scan_slab(0, b.ic, axis, b.o, b.d, t_far, max(tminB, b.t_cur - pad), r_mul, b.best_t, b.found);
                    slab_inB = b.t_cur;
                    slab_outB = min(min(b.tmaxv.x, b.tmaxv.y), min(b.tmaxv.z, b.tmax));
                    didB = true;
                } else b.act = false;
            } else b.act = false;
        } else if (b.act) b.act = false;
        if (didA || didB) {
            for (int l = 1; l < u_levels; ++l)
                descend2(l, t_far, r_mul,
                         a, slab_inA, slab_outA, didA ? ta_inA[l] : 1e30, ta_outA[l],
                         b, slab_inB, slab_outB, didB ? ta_inB[l] : 1e30, ta_outB[l]);
        }
    }
    if (u_perf != 0) PERF_CYC(7, trav0);
}


// Trace a ray: DDA through the coarsest grid; on every coarse cell, descend
// into all finer levels whose AABB overlaps the cell's t-interval. The first
// surfel disk hit is found per the paper; the surface is then reconstructed
// with the paper's interpolation (Eq. 1) over the tangent-plane disk distances,
// gathering neighbors from ALL levels.
// Returns the best-hit ray parameter, or -1 on miss.
float trace_best(vec3 o, vec3 d, float t_near, float t_far, float r_mul) {
    uint trav0 = 0;
    if (u_perf != 0) trav0 = clock2x32ARB().x;
    float cs0 = 1.0 / u_l_inv_cell[0];
    float pad = search_r(r_mul);
    vec3 bmin = u_l_min[0];
    vec3 bmax = u_l_min[0] + vec3(u_l_res[0]) * cs0;

    // --- Clip ray to coarsest grid AABB ---
    float tmin = t_near;
    float tmax = t_far;
    for (int a = 0; a < 3; ++a) {
        float da = d[a];
        float oa = o[a];
        if (abs(da) < 1e-20) {
            if (oa < bmin[a] || oa > bmax[a]) { PERF_CYC(7, trav0); return -1.0; }
        } else {
            float t0 = (bmin[a] - oa) / da;
            float t1 = (bmax[a] - oa) / da;
            if (t0 > t1) { float tmp = t0; t0 = t1; t1 = tmp; }
            tmin = max(tmin, t0);
            tmax = min(tmax, t1);
            if (tmin > tmax) { PERF_CYC(7, trav0); return -1.0; }
        }
    }
    if (tmax < t_near || tmin > t_far) { PERF_CYC(7, trav0); return -1.0; }

    // --- Level-0 DDA with descents into finer levels ---
    vec3 p0 = o + d * tmin;
    ivec3 ic = clamp(ivec3(floor((p0 - bmin) * u_l_inv_cell[0])), ivec3(0), u_l_res[0] - 1);
    vec3 cell_min = bmin + vec3(ic) * cs0;
    vec3 tmaxv;
    tmaxv.x = (d.x > 1e-12) ? (cell_min.x + cs0 - p0.x) / d.x :
              ((d.x < -1e-12) ? (cell_min.x - p0.x) / d.x : 1e30);
    tmaxv.y = (d.y > 1e-12) ? (cell_min.y + cs0 - p0.y) / d.y :
              ((d.y < -1e-12) ? (cell_min.y - p0.y) / d.y : 1e30);
    tmaxv.z = (d.z > 1e-12) ? (cell_min.z + cs0 - p0.z) / d.z :
              ((d.z < -1e-12) ? (cell_min.z - p0.z) / d.z : 1e30);
    vec3 tdelta = cs0 / (abs(d) + 1e-20);
    ivec3 stepv = ivec3(sign(d));

    float t_cur = tmin;
    bool found = false;
    float best_t = 1e30;

    // Per-ray level-AABB intervals (once per ray instead of once per descend
    // call; max/min folds are exact so the clip result is bit-identical).
    float ta_in[kLevels], ta_out[kLevels];
    for (int l = 1; l < u_levels; ++l) {
        ta_in[l] = -1e30;
        ta_out[l] = 1e30;
        if (u_l_num[l] == 0u) continue;
        vec3 lbmin = u_l_min[l];
        float lcs = 1.0 / u_l_inv_cell[l];
        vec3 lbmax = lbmin + vec3(u_l_res[l]) * lcs;
        bool miss = false;
        for (int a = 0; a < 3; ++a) {
            float da = d[a], oa = o[a];
            if (abs(da) < 1e-20) {
                if (oa < lbmin[a] || oa > lbmax[a]) miss = true;
            } else {
                float t0 = (lbmin[a] - oa) / da;
                float t1 = (lbmax[a] - oa) / da;
                if (t0 > t1) { float tmp = t0; t0 = t1; t1 = tmp; }
                ta_in[l] = max(ta_in[l], t0);
                ta_out[l] = min(ta_out[l], t1);
            }
        }
        if (miss) ta_in[l] = 1e30;   // force the empty clip in descend
    }

    // Entry cell: full neighborhood + descents.
    {
        PERF_ADD(1, 1);
        float relax_near = max(tmin, t_cur - pad);
        scan_neighborhood(0, ic, o, d, t_far, relax_near, r_mul, best_t, found);
        float t_exit = min(min(tmaxv.x, tmaxv.y), min(tmaxv.z, tmax));
        for (int l = 1; l < u_levels; ++l)
            descend(l, o, d, t_cur, t_exit, t_far, r_mul, ta_in[l], ta_out[l], best_t, found);
    }
    for (int iter = 0; iter < 512; ++iter) {
        if (found && t_cur > best_t + pad) break;
        float tn = min(tmaxv.x, min(tmaxv.y, tmaxv.z));
        if (tn >= tmax) break;
        t_cur = tn;
        int axis;
        if (tn == tmaxv.x) { ic.x += stepv.x; tmaxv.x += tdelta.x; axis = 0; }
        else if (tn == tmaxv.y) { ic.y += stepv.y; tmaxv.y += tdelta.y; axis = 1; }
        else { ic.z += stepv.z; tmaxv.z += tdelta.z; axis = 2; }
        if (!l_in_bounds(0, ic)) break;
        // Newly entered cell is already beyond the best hit (its disks cannot
        // win: hits lie at t >= t_cur - pad > best_t) — skip its slab scan.
        if (found && t_cur > best_t + pad) break;
        PERF_ADD(1, 1);
        float relax_near = max(tmin, t_cur - pad);
        scan_slab(0, ic, axis, o, d, t_far, relax_near, r_mul, best_t, found);
        float t_exit = min(min(tmaxv.x, tmaxv.y), min(tmaxv.z, tmax));
        for (int l = 1; l < u_levels; ++l)
            descend(l, o, d, t_cur, t_exit, t_far, r_mul, ta_in[l], ta_out[l], best_t, found);
    }

    if (!found) { PERF_CYC(7, trav0); return -1.0; }

    PERF_CYC(7, trav0);
    return best_t;
}


void main() {
    // Zero the shared counters, then converge: every thread must reach BOTH
    // barriers, so early-out paths are guarded with if-blocks, not returns.
    if (int(gl_LocalInvocationIndex) < 10) lperf[gl_LocalInvocationIndex] = 0u;
    barrier();

    uint rid = gl_GlobalInvocationID.x;
    uint n = counts[u_bounce];
    if (u_pair != 0) {
        // Two interleaved rays per thread: the second ray's independent load
        // stream hides the first ray's grid-probe latency (occupancy is
        // capped by the ray count, not by SM resources).
        uint r0 = rid * 2u, r1 = r0 + 1u;
        bool hasA = r0 < n, hasB = r1 < n;
        DdaX a, b;
        a.best_t = 1e30; a.found = false; a.act = hasA;
        b.best_t = 1e30; b.found = false; b.act = hasB;
        if (hasA) {
            vec4 e0 = stream_in[2u * r0];
            vec4 e1 = stream_in[2u * r0 + 1u];
            a.o = e0.yzw; a.d = e1.xyz;
        }
        if (hasB) {
            vec4 e0 = stream_in[2u * r1];
            vec4 e1 = stream_in[2u * r1 + 1u];
            b.o = e0.yzw; b.d = e1.xyz;
        }
        PERF_ADD(0, hasA ? 1u : 0u);
        PERF_ADD(0, hasB ? 1u : 0u);
        trace_best2(a, b, 1e-3, u_far, 1.0);
        if (hasA) hit_buf[r0] = a.found ? a.best_t : -1.0;
        if (hasB) hit_buf[r1] = b.found ? b.best_t : -1.0;
    } else if (rid < n) {
        uint t_setup0 = 0;
        if (u_perf != 0) t_setup0 = clock2x32ARB().x;

        // Ray from the stream: pixel id + precomputed origin/direction.
        vec4 e0 = stream_in[2u * rid];
        vec4 e1 = stream_in[2u * rid + 1u];
        vec3 ro = e0.yzw;
        vec3 rd = e1.xyz;

        PERF_CYC(6, t_setup0);         // setup cycles, once per ray
        // Single-pass trace at the uniform radius. (An inflated retry on
        // miss was tried to fill grazing gaps: it also lets grazing rays
        // hit unrelated surfaces and turned the mirror into noise.)
        PERF_ADD(0, 1);                // rays (traced)
        float best_t = trace_best(ro, rd, 1e-3, u_far, 1.0);
        hit_buf[rid] = best_t;
    }

    // Flush the shared counters to global memory (one atomicAdd per workgroup
    // per counter instead of ~3k per ray).
    barrier();
    if (u_perf != 0 && int(gl_LocalInvocationIndex) < 10)
        atomicAdd(perf[gl_LocalInvocationIndex], lperf[gl_LocalInvocationIndex]);
}
