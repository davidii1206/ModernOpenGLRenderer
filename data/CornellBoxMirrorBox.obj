# Cornell Box (Inward-Facing, 6-Sided, Reflective Material)
# Dimensions: 2x2x2 centered around origin (-1 to 1)

mtllib CornellBoxMirrorBox.mtl
usemtl ReflectiveMaterial

# 8 Vertices
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0

# 6 Normals (Pointing INWARD toward the box center)
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

# 6 Faces (Clockwise vertex ordering relative to outside views, matching inward normals)
# Back wall (Z = -1)
f 5//1 6//1 7//1 8//1

# Front wall (Z = +1)
f 1//2 4//2 3//2 2//2

# Left wall (X = -1)
f 1//3 5//3 8//3 4//3

# Right wall (X = +1)
f 2//4 3//4 7//4 6//4

# Floor (Y = -1)
f 1//5 2//5 6//5 5//5

# Ceiling (Y = +1)
f 4//6 8//6 7//6 3//6